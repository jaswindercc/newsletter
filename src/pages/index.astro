---
import Base from '../layouts/Base.astro'
import site from '../config/site.json'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
  publisher: { '@type': 'Organization', name: site.name },
  potentialAction: {
    '@type': 'ReadAction',
    target: `${site.url}/issue/2026-week17`,
  },
}

const issues = [
  {
    slug: '2026-week17',
    number: '2026-17',
    date: 'Apr 27 – May 3, 2026',
    week: 17,
    year: 2026,
    status: 'live',
    title: 'Apple CEO Succession, GCP 63% Surge, Linux Root Exploit',
    stats: { stories: 29, categories: 7, readTime: '20 min' },
    highlights: [
      { category: 'Macro', color: 'bg-blue', text: 'U.S. Q1 GDP accelerates to 2.0%' },
      { category: 'Tech', color: 'bg-purple', text: 'John Ternus named Apple CEO successor' },
      { category: 'Cloud', color: 'bg-green', text: 'Google Cloud reports 63% revenue surge' },
      { category: 'AI', color: 'bg-orange', text: 'Microsoft AI run rate hits $37B' },
      { category: 'Sec', color: 'bg-red', text: 'CVE-2026-31431 Linux root privilege escalation' },
      { category: 'Geo', color: 'bg-pink', text: 'China blocks Meta acquisition of Manus' },
    ],
  },
  {
    slug: '2026-week18',
    number: '2026-18',
    date: 'May 4 – May 10, 2026',
    week: 18,
    year: 2026,
    status: 'draft',
    title: 'Coming Soon',
    stats: { stories: 0, categories: 0, readTime: '—' },
    highlights: [],
  },
]


---

<Base title={`${site.shortName} — ${site.tagline}`} description={site.metaDescription} jsonLd={jsonLd}>
  <div class="max-w-[1080px] mx-auto px-6 py-12">
    <!-- Hero -->
    <div class="mb-14">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-flex items-center gap-2 px-3 py-1 text-[13px] font-medium text-green bg-green/10 border border-green/20 rounded-full">
          <span class="w-2 h-2 rounded-full bg-green animate-pulse"></span>
          Issue 2026-17 is live
        </span>
      </div>
      <h1 class="text-[44px] font-extrabold leading-[1.1] tracking-tight">
        {site.homepage.heroHeadline.split('\n')[0]}<br/>
        <span class="text-blue">{site.homepage.heroHighlight}</span>
      </h1>
      <p class="mt-5 text-[17px] text-text-secondary leading-relaxed max-w-[600px]">
        {site.homepage.heroParagraph}
      </p>
      <p class="mt-3 text-[15px] text-text-tertiary leading-relaxed max-w-[600px]">
        {site.homepage.valueProposition}
      </p>
    </div>



    <!-- Issues -->
    <div class="space-y-4 mb-14">
      {issues.map((issue) => (
        <a href={`/issue/${issue.slug}`} class="block group">
          <article class="border border-border rounded-xl p-6 hover:bg-bg-card hover:border-blue/40 transition-all duration-200">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-3">
                <span class="font-mono text-[13px] text-text-tertiary font-medium">{issue.number}</span>
                {issue.status === 'live' ? (
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[12px] font-semibold text-green bg-green/10 border border-green/20 rounded-md">
                    <span class="w-1.5 h-1.5 rounded-full bg-green animate-pulse"></span>
                    LIVE
                  </span>
                ) : issue.status === 'draft' ? (
                  <span class="px-2 py-0.5 text-[12px] font-medium text-orange bg-orange/10 border border-orange/20 rounded-md">
                    DRAFT
                  </span>
                ) : (
                  <span class="px-2 py-0.5 text-[12px] font-medium text-text-tertiary bg-bg-accent/50 border border-border rounded-md">
                    ARCHIVE
                  </span>
                )}
              </div>
              <span class="text-[14px] text-text-tertiary">{issue.date}</span>
            </div>

            <h2 class="text-[20px] font-bold text-text group-hover:text-blue transition-colors leading-snug">
              {issue.title}
            </h2>

            <div class="mt-3 flex gap-5 text-[14px] text-text-secondary font-mono">
              <span>{issue.stats.stories} stories</span>
              <span>{issue.stats.categories} categories</span>
              <span>~{issue.stats.readTime}</span>
            </div>

            <!-- Highlight Pills -->
            <div class="mt-4 flex flex-wrap gap-2">
              {issue.highlights.map((h) => (
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[13px] text-text-secondary bg-bg-hover border border-border rounded-lg">
                  <span class={`w-2 h-2 rounded-full ${h.color}`}></span>
                  {h.text}
                </span>
              ))}
            </div>

            <div class="mt-5 flex items-center gap-1.5 text-[14px] font-medium text-blue opacity-0 group-hover:opacity-100 transition-opacity">
              Read full issue
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </article>
        </a>
      ))}
    </div>



    <!-- Subscribe CTA -->
    <div class="p-8 rounded-xl bg-gradient-to-br from-blue/10 via-purple/5 to-bg-card border border-blue/20 text-center">
      <h3 class="text-[22px] font-bold text-text">{site.subscribe.heading}</h3>
      <p class="mt-2 text-[15px] text-text-secondary max-w-[400px] mx-auto">{site.subscribe.description}</p>
      <div class="mt-5 flex items-center justify-center gap-3 max-w-[400px] mx-auto">
        <input type="email" placeholder={site.subscribe.placeholder} class="flex-1 px-4 py-2.5 text-[14px] bg-bg border border-border rounded-lg text-text placeholder-text-tertiary focus:outline-none focus:border-blue/50 focus:ring-1 focus:ring-blue/30 transition-all" />
        <button class="px-5 py-2.5 text-[14px] font-semibold text-bg bg-blue hover:bg-blue-dark rounded-lg transition-colors">
          {site.subscribe.buttonText}
        </button>
      </div>
    </div>
  </div>
</Base>
