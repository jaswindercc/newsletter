---
import Base from '../layouts/Base.astro'

const issues = [
  {
    slug: '2026-week18',
    number: 43,
    date: 'Apr 28 – May 1, 2026',
    week: 18,
    year: 2026,
    status: 'live',
    title: 'GPT-5 Turbo Drops, Rust Gets Async Drop, npm Gets Wrecked',
    stats: { stories: 27, categories: 6, readTime: '18 min' },
    highlights: [
      { category: 'AI', color: 'bg-purple', text: 'OpenAI ships GPT-5 Turbo — 1M context' },
      { category: 'Dev', color: 'bg-green', text: 'Rust 1.84 finally adds async drop' },
      { category: 'Sec', color: 'bg-red', text: 'npm attack hits 15K packages' },
      { category: 'Infra', color: 'bg-blue', text: 'Linux 6.14 real-time scheduling' },
      { category: 'Biz', color: 'bg-orange', text: 'Cloudflare acquires Deno $420M' },
      { category: 'HW', color: 'bg-pink', text: 'TSMC 2nm enters mass production' },
    ],
  },
  {
    slug: '2026-week17',
    number: 42,
    date: 'Apr 21 – Apr 27, 2026',
    week: 17,
    year: 2026,
    status: 'archived',
    title: 'Gemini Ultra 2.0, Postgres 18, COBOL Gets Modern',
    stats: { stories: 23, categories: 6, readTime: '15 min' },
    highlights: [
      { category: 'AI', color: 'bg-purple', text: 'Google drops Gemini Ultra 2.0' },
      { category: 'Dev', color: 'bg-green', text: 'IBM ships COBOL LSP for VS Code' },
      { category: 'Infra', color: 'bg-blue', text: 'PostgreSQL 18 native sharding' },
      { category: 'Biz', color: 'bg-orange', text: 'Figma acquires Replit $1.2B' },
      { category: 'Sec', color: 'bg-red', text: 'Apple M5 side-channel vuln' },
      { category: 'HW', color: 'bg-pink', text: 'NVIDIA B200 ships, H100 craters' },
    ],
  },
]

const trendingTopics = [
  { name: 'GPT-5', mentions: 142, trend: '+340%' },
  { name: 'Rust', mentions: 89, trend: '+120%' },
  { name: 'npm security', mentions: 67, trend: '+890%' },
  { name: 'PostgreSQL', mentions: 54, trend: '+65%' },
  { name: 'COBOL', mentions: 38, trend: '+210%' },
]

const categoryBreakdown = [
  { name: 'AI & ML', count: 11, color: 'bg-purple', pct: 22 },
  { name: 'Dev Tools', count: 10, color: 'bg-green', pct: 20 },
  { name: 'Infrastructure', count: 9, color: 'bg-blue', pct: 18 },
  { name: 'Security', count: 7, color: 'bg-red', pct: 14 },
  { name: 'Startups', count: 6, color: 'bg-orange', pct: 12 },
  { name: 'Hardware', count: 7, color: 'bg-pink', pct: 14 },
]
---

<Base title="jas — Weekly Tech Rundown">
  <div class="max-w-[1080px] mx-auto px-6 py-12">
    <!-- Hero -->
    <div class="mb-14">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-flex items-center gap-2 px-3 py-1 text-[13px] font-medium text-green bg-green/10 border border-green/20 rounded-full">
          <span class="w-2 h-2 rounded-full bg-green animate-pulse"></span>
          Issue #43 is live
        </span>
      </div>
      <h1 class="text-[44px] font-extrabold leading-[1.1] tracking-tight">
        Your weekly<br/>
        <span class="text-blue">tech rundown.</span>
      </h1>
      <p class="mt-5 text-[17px] text-text-secondary leading-relaxed max-w-[600px]">
        Every story that matters in technology — AI breakthroughs, dev tool releases, security incidents, infrastructure shifts, and startup moves. Interactive, organized, readable.
      </p>
    </div>

    <!-- Live Stats Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-10">
      <div class="p-4 rounded-xl bg-bg-card border border-border">
        <div class="text-[28px] font-bold text-text">50</div>
        <div class="text-[13px] text-text-tertiary mt-0.5">Stories this cycle</div>
      </div>
      <div class="p-4 rounded-xl bg-bg-card border border-border">
        <div class="text-[28px] font-bold text-red">4</div>
        <div class="text-[13px] text-text-tertiary mt-0.5">Critical alerts</div>
      </div>
      <div class="p-4 rounded-xl bg-bg-card border border-border">
        <div class="text-[28px] font-bold text-green">6</div>
        <div class="text-[13px] text-text-tertiary mt-0.5">Major releases</div>
      </div>
      <div class="p-4 rounded-xl bg-bg-card border border-border">
        <div class="text-[28px] font-bold text-purple">3</div>
        <div class="text-[13px] text-text-tertiary mt-0.5">Acquisitions</div>
      </div>
    </div>

    <!-- Issues -->
    <div class="space-y-4 mb-14">
      {issues.map((issue) => (
        <a href={`/issue/${issue.slug}`} class="block group">
          <article class="border border-border rounded-xl p-6 hover:bg-bg-card hover:border-blue/40 transition-all duration-200">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-3">
                <span class="font-mono text-[13px] text-text-tertiary font-medium">#{issue.number}</span>
                {issue.status === 'live' ? (
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[12px] font-semibold text-green bg-green/10 border border-green/20 rounded-md">
                    <span class="w-1.5 h-1.5 rounded-full bg-green animate-pulse"></span>
                    LIVE
                  </span>
                ) : (
                  <span class="px-2 py-0.5 text-[12px] font-medium text-text-tertiary bg-bg-accent/50 border border-border rounded-md">
                    ARCHIVE
                  </span>
                )}
              </div>
              <span class="text-[14px] text-text-tertiary">{issue.date}</span>
            </div>

            <h2 class="text-[20px] font-bold text-text group-hover:text-blue transition-colors leading-snug">
              {issue.title}
            </h2>

            <div class="mt-3 flex gap-5 text-[14px] text-text-secondary font-mono">
              <span>{issue.stats.stories} stories</span>
              <span>{issue.stats.categories} categories</span>
              <span>~{issue.stats.readTime}</span>
            </div>

            <!-- Highlight Pills -->
            <div class="mt-4 flex flex-wrap gap-2">
              {issue.highlights.map((h) => (
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[13px] text-text-secondary bg-bg-hover border border-border rounded-lg">
                  <span class={`w-2 h-2 rounded-full ${h.color}`}></span>
                  {h.text}
                </span>
              ))}
            </div>

            <div class="mt-5 flex items-center gap-1.5 text-[14px] font-medium text-blue opacity-0 group-hover:opacity-100 transition-opacity">
              Read full issue
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </article>
        </a>
      ))}
    </div>

    <!-- Widgets Row -->
    <div class="grid md:grid-cols-2 gap-4 mb-14">
      <!-- Trending Topics -->
      <div class="p-5 rounded-xl bg-bg-card border border-border">
        <h3 class="text-[16px] font-bold text-text mb-4 flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-orange"><path d="m22 2-7 20-4-9-9-4 20-7Z"/></svg>
          Trending This Week
        </h3>
        <div class="space-y-3">
          {trendingTopics.map((topic, i) => (
            <div class="flex items-center gap-3">
              <span class="text-[13px] font-mono text-text-tertiary w-5">{i + 1}.</span>
              <span class="text-[14px] font-medium text-text flex-1">{topic.name}</span>
              <span class="text-[13px] font-mono text-text-tertiary">{topic.mentions} mentions</span>
              <span class="text-[13px] font-mono font-semibold text-green">{topic.trend}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Category Breakdown -->
      <div class="p-5 rounded-xl bg-bg-card border border-border">
        <h3 class="text-[16px] font-bold text-text mb-4 flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Category Breakdown
        </h3>
        <div class="space-y-3">
          {categoryBreakdown.map((cat) => (
            <div class="flex items-center gap-3">
              <span class={`w-3 h-3 rounded ${cat.color} shrink-0`}></span>
              <span class="text-[14px] text-text flex-1">{cat.name}</span>
              <span class="text-[13px] font-mono text-text-tertiary">{cat.count}</span>
              <div class="w-20 h-2 rounded-full bg-bg-hover overflow-hidden">
                <div class={`h-full rounded-full ${cat.color}`} style={`width:${cat.pct}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Weekly Pulse -->
    <div class="p-6 rounded-xl bg-bg-card border border-border mb-14">
      <h3 class="text-[16px] font-bold text-text mb-5 flex items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-blue"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        Weekly Pulse
      </h3>
      <div class="grid grid-cols-7 gap-1 mb-3">
        {['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map((day) => (
          <div class="text-center text-[12px] font-mono text-text-tertiary">{day}</div>
        ))}
      </div>
      <div class="grid grid-cols-7 gap-1">
        {[8, 12, 6, 9, 14, 3, 2].map((count, i) => (
          <div class="flex flex-col items-center gap-1">
            <div class="w-full aspect-square rounded-lg flex items-center justify-center text-[14px] font-bold" style={`background: rgba(96, 165, 250, ${Math.min(count / 14, 1) * 0.4 + 0.05}); color: ${count > 8 ? '#60a5fa' : '#a1a1aa'}`}>
              {count}
            </div>
          </div>
        ))}
      </div>
      <p class="mt-3 text-[13px] text-text-tertiary">Stories published per day this week. Peak: Thursday (14 stories).</p>
    </div>

    <!-- Subscribe CTA -->
    <div class="p-8 rounded-xl bg-gradient-to-br from-blue/10 via-purple/5 to-bg-card border border-blue/20 text-center">
      <h3 class="text-[22px] font-bold text-text">Stay in the loop</h3>
      <p class="mt-2 text-[15px] text-text-secondary max-w-[400px] mx-auto">Get the rundown in your inbox every Monday. Curated, interactive, free.</p>
      <div class="mt-5 flex items-center justify-center gap-3 max-w-[400px] mx-auto">
        <input type="email" placeholder="you@company.com" class="flex-1 px-4 py-2.5 text-[14px] bg-bg border border-border rounded-lg text-text placeholder-text-tertiary focus:outline-none focus:border-blue/50 focus:ring-1 focus:ring-blue/30 transition-all" />
        <button class="px-5 py-2.5 text-[14px] font-semibold text-bg bg-blue hover:bg-blue-dark rounded-lg transition-colors">
          Subscribe
        </button>
      </div>
    </div>
  </div>
</Base>
