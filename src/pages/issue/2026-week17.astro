            <div class="flex justify-between text-[13px]"><span class="text-text-tertiary">Daily</span><span id="sla-daily" class="font-mono font-bold text-green">1m 26s</span></div>
            <div class="flex justify-between text-[13px]"><span class="text-text-tertiary">Weekly</span><span id="sla-weekly" class="font-mono font-bold text-green">10m 5s</span></div>
            <div class="flex justify-between text-[13px]"><span class="text-text-tertiary">Monthly</span><span id="sla-monthly" class="font-mono font-bold text-green">43m 50s</span></div>
            <div class="flex justify-between text-[13px]"><span class="text-text-tertiary">Yearly</span><span id="sla-yearly" class="font-mono font-bold text-green">8h 46m</span></div>
          </div>
        </div>
        <div class="mt-3 flex justify-end">
          <a href="/tools/sla-downtime-calculator" class="text-[12px] text-text-tertiary hover:text-blue transition-colors inline-flex items-center gap-1">Open full tool <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
      </div>

      <!-- Meeting Cost Calculator -->
      <div class="p-5 rounded-xl bg-bg-card border border-border">
        <h3 class="text-[15px] font-bold text-text mb-1 flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-red"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Meeting Cost Calculator
        </h3>
        <p class="text-[13px] text-text-tertiary mb-4">What that "quick sync" actually costs.</p>
        <div class="space-y-3">
          <div>
            <label class="text-[12px] font-medium text-text-secondary block mb-1">Attendees</label>
            <input type="range" id="mtg-people" min="2" max="20" value="6" class="w-full accent-red" />
            <div class="flex justify-between text-[12px] text-text-tertiary"><span>2</span><span id="mtg-people-val">6</span><span>20</span></div>
          </div>
          <div>
            <label class="text-[12px] font-medium text-text-secondary block mb-1">Duration (minutes)</label>
            <input type="range" id="mtg-mins" min="15" max="120" value="30" step="15" class="w-full accent-red" />
            <div class="flex justify-between text-[12px] text-text-tertiary"><span>15m</span><span id="mtg-mins-val">30m</span><span>120m</span></div>
          </div>
          <div>
            <label class="text-[12px] font-medium text-text-secondary block mb-1">Avg Hourly Cost ($)</label>
            <input type="range" id="mtg-rate" min="50" max="250" value="95" step="5" class="w-full accent-red" />
            <div class="flex justify-between text-[12px] text-text-tertiary"><span>$50</span><span id="mtg-rate-val">$95</span><span>$250</span></div>
          </div>
          <div class="pt-3 border-t border-border">
            <div class="text-[13px] text-text-tertiary">This meeting costs</div>
            <div id="mtg-cost" class="text-[28px] font-bold text-red">$285</div>
            <div class="text-[12px] text-text-tertiary mt-1">Weekly recurring? <span id="mtg-yearly" class="font-bold text-red">$14,820</span>/year</div>
          </div>
        </div>
        <div class="mt-3 flex justify-end">
          <a href="/tools/meeting-cost-calculator" class="text-[12px] text-text-tertiary hover:text-blue transition-colors inline-flex items-center gap-1">Open full tool <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // SLA Calculator
    const slaTarget = document.getElementById('sla-target') as HTMLSelectElement
    function formatDur(s: number): string {
      if (s < 60) return Math.round(s) + 's'
      if (s < 3600) return Math.floor(s / 60) + 'm ' + Math.round(s % 60) + 's'
      return Math.floor(s / 3600) + 'h ' + Math.round((s % 3600) / 60) + 'm'
    }
    function calcSla() {
      const pct = parseFloat(slaTarget.value)
      const d = (100 - pct) / 100
      document.getElementById('sla-daily')!.textContent = formatDur(86400 * d)
      document.getElementById('sla-weekly')!.textContent = formatDur(604800 * d)
      document.getElementById('sla-monthly')!.textContent = formatDur(2592000 * d)
      document.getElementById('sla-yearly')!.textContent = formatDur(31536000 * d)
    }
    slaTarget.addEventListener('change', calcSla)
    calcSla()

    // Meeting Cost
    const mtgP = document.getElementById('mtg-people') as HTMLInputElement
    const mtgM = document.getElementById('mtg-mins') as HTMLInputElement
    const mtgR = document.getElementById('mtg-rate') as HTMLInputElement
    function calcMtg() {
      const p = parseInt(mtgP.value), m = parseInt(mtgM.value), r = parseInt(mtgR.value)
      document.getElementById('mtg-people-val')!.textContent = String(p)
      document.getElementById('mtg-mins-val')!.textContent = m + 'm'
      document.getElementById('mtg-rate-val')!.textContent = '$' + r
      const cost = p * (m / 60) * r
      document.getElementById('mtg-cost')!.textContent = '$' + Math.round(cost).toLocaleString()
      document.getElementById('mtg-yearly')!.textContent = '$' + Math.round(cost * 52).toLocaleString()
    }
    mtgP.addEventListener('input', calcMtg)
    mtgM.addEventListener('input', calcMtg)
    mtgR.addEventListener('input', calcMtg)
    calcMtg()
  </script>
</IssueLayout>
