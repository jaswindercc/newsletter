---
import IssueLayout from '../../layouts/IssueLayout.astro'

const meta = {
  number: '2026-18',
  date: 'May 4 – May 10, 2026',
  title: 'Week 18, 2026',
  status: 'draft' as const,
  prevIssue: '2026-week17',
  marketDateLabel: 'Week ending May 10, 2026',
}

// ALL DATA BELOW MUST BE VERIFIED WITH EXACT SOURCE URLS BEFORE PUBLISHING
// Replace placeholder entries with real, verified news only.
// If a story cannot be sourced to a specific article URL, DELETE IT.

const generalNews: { date: string; title: string; summary: string; source: string; sourceUrl: string }[] = []

const majorTechNews: { date: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; source: string; sourceUrl: string }[] = []

const majorAcquisitions: { buyer: string; target: string; amount: string; why: string; source: string; sourceUrl: string }[] = []

const catalysts: { date: string; event: string; detail: string; source: string; sourceUrl: string }[] = []

const marketData = {
  indices: [] as { name: string; value: string; change: string; direction: 'up' | 'down'; ytd: string; ytdDir: 'up' | 'down' }[],
  stocks: [] as { ticker: string; name: string; price: string; change: string; ytd: string; reason: string; source: string; sourceUrl: string }[],
}

const sections = [
  { title: 'Tech Rumours', icon: 'S.06', color: 'text-orange', items: [] as { date?: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source?: string; sourceUrl?: string }[] },
  { title: 'Top 5 Security Vulnerabilities', icon: 'S.07', color: 'text-red', items: [] as { date?: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source?: string; sourceUrl?: string }[] },
  { title: 'Security News', icon: 'S.08', color: 'text-red', items: [] as { date?: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source?: string; sourceUrl?: string }[] },
  { title: 'Deprecations & End-of-Life', icon: 'S.09', color: 'text-text-tertiary', items: [] as { date?: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source?: string; sourceUrl?: string }[] },
  { title: 'Products & Cloud Pricing', icon: 'S.10', color: 'text-green', items: [] as { date?: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source?: string; sourceUrl?: string }[] },
  { title: 'Open Source Governance & Forks', icon: 'S.11', color: 'text-green', items: [] as { date?: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source?: string; sourceUrl?: string }[] },
  { title: 'Regulatory Compliance Drift', icon: 'S.12', color: 'text-blue', items: [] as { date?: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source?: string; sourceUrl?: string }[] },
  { title: 'Legacy Modernization Tracker', icon: 'S.13', color: 'text-cyan', items: [] as { date?: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source?: string; sourceUrl?: string }[] },
  { title: 'Developer Velocity & Tooling', icon: 'S.14', color: 'text-green', items: [] as { date?: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source?: string; sourceUrl?: string }[] },
  { title: 'Sovereign Cloud & Data Residency', icon: 'S.15', color: 'text-blue', items: [] as { date?: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source?: string; sourceUrl?: string }[] },
  { title: 'AI Model Benchmarks', icon: 'S.16', color: 'text-purple', items: [] as { date?: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source?: string; sourceUrl?: string }[] },
  { title: 'Category Deep Dives', icon: 'S.17', color: 'text-pink', items: [] as { date?: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source?: string; sourceUrl?: string }[] },
]
---

<IssueLayout
  meta={meta}
  generalNews={generalNews}
  majorTechNews={majorTechNews}
  majorAcquisitions={majorAcquisitions}
  catalysts={catalysts}
  marketData={marketData}
  sections={sections}
>
  <!-- Interactive Widgets (per-issue) -->
  <div class="mt-14 mb-10">
    <h2 class="text-[22px] font-bold text-text mb-6 flex items-center gap-3">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan shrink-0"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 3h-8l-2 4h12z"/></svg>
      Interactive Tools
    </h2>
    <div class="grid md:grid-cols-2 gap-4">
      <!-- Cloud Cost Estimator -->
      <div class="p-5 rounded-xl bg-bg-card border border-border">
        <h3 class="text-[15px] font-bold text-text mb-1 flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-green"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Cloud Cost Estimator
        </h3>
        <p class="text-[13px] text-text-tertiary mb-4">Estimate monthly cloud spend for AI workloads.</p>
        <div class="space-y-3">
          <div>
            <label class="text-[12px] font-medium text-text-secondary block mb-1">GPU Type</label>
            <select id="gpu-type" class="w-full px-3 py-2 text-[13px] bg-bg border border-border rounded-lg text-text focus:border-blue/50 focus:outline-none">
              <option value="3.25">NVIDIA H100 ($3.25/hr)</option>
              <option value="6.50">NVIDIA B200 ($6.50/hr)</option>
              <option value="1.10">NVIDIA A100 ($1.10/hr)</option>
              <option value="0.45">NVIDIA T4 ($0.45/hr)</option>
            </select>
          </div>
          <div>
            <label class="text-[12px] font-medium text-text-secondary block mb-1">GPUs Needed</label>
            <input type="range" id="gpu-count" min="1" max="64" value="4" class="w-full accent-green" />
            <div class="flex justify-between text-[12px] text-text-tertiary"><span>1</span><span id="gpu-count-val">4</span><span>64</span></div>
          </div>
          <div>
            <label class="text-[12px] font-medium text-text-secondary block mb-1">Hours/Day</label>
            <input type="range" id="gpu-hours" min="1" max="24" value="8" class="w-full accent-green" />
            <div class="flex justify-between text-[12px] text-text-tertiary"><span>1</span><span id="gpu-hours-val">8</span><span>24</span></div>
          </div>
          <div class="pt-3 border-t border-border">
            <div class="text-[13px] text-text-tertiary">Estimated Monthly Cost</div>
            <div id="cloud-cost" class="text-[28px] font-bold text-green">$3,120</div>
          </div>
        </div>
        <div class="mt-3 flex justify-end">
          <a href="/tools/cloud-cost-estimator" class="text-[12px] text-text-tertiary hover:text-blue transition-colors inline-flex items-center gap-1">Open full tool <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
      </div>

      <!-- AI API Cost Comparison -->
      <div class="p-5 rounded-xl bg-bg-card border border-border">
        <h3 class="text-[15px] font-bold text-text mb-1 flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-purple"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          AI API Cost Comparison
        </h3>
        <p class="text-[13px] text-text-tertiary mb-4">Compare costs per 1M tokens (input / output).</p>
        <div class="space-y-2">
          <div class="flex items-center gap-2 p-2 rounded-lg bg-bg-hover">
            <span class="w-2 h-2 rounded-full bg-purple"></span>
            <span class="text-[13px] text-text flex-1">GPT-5 Turbo</span>
            <span class="text-[13px] font-mono text-text-secondary">$5 / $15</span>
          </div>
          <div class="flex items-center gap-2 p-2 rounded-lg bg-bg-hover">
            <span class="w-2 h-2 rounded-full bg-orange"></span>
            <span class="text-[13px] text-text flex-1">Claude 4.5</span>
            <span class="text-[13px] font-mono text-text-secondary">$15 / $75</span>
          </div>
          <div class="flex items-center gap-2 p-2 rounded-lg bg-bg-hover">
            <span class="w-2 h-2 rounded-full bg-blue"></span>
            <span class="text-[13px] text-text flex-1">Gemini Ultra 2.0</span>
            <span class="text-[13px] font-mono text-text-secondary">$7 / $21</span>
          </div>
          <div class="flex items-center gap-2 p-2 rounded-lg bg-bg-hover">
            <span class="w-2 h-2 rounded-full bg-green"></span>
            <span class="text-[13px] text-text flex-1">Llama 4 (self-hosted)</span>
            <span class="text-[13px] font-mono text-text-secondary">~$0.80 / ~$0.80</span>
          </div>
          <div class="pt-3 border-t border-border mt-3">
            <label class="text-[12px] font-medium text-text-secondary block mb-1">Monthly Tokens (Millions)</label>
            <input type="range" id="token-usage" min="1" max="100" value="10" class="w-full accent-purple" />
            <div class="flex justify-between text-[12px] text-text-tertiary"><span>1M</span><span id="token-usage-val">10M</span><span>100M</span></div>
            <div class="mt-2 text-[13px] text-text-tertiary">Cheapest: <span id="cheapest-model" class="font-bold text-green">Llama 4</span> at <span id="cheapest-cost" class="font-bold text-green">$16/mo</span></div>
          </div>
        </div>
        <div class="mt-3 flex justify-end">
          <a href="/tools/ai-api-cost-comparison" class="text-[12px] text-text-tertiary hover:text-blue transition-colors inline-flex items-center gap-1">Open full tool <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Cloud Cost Estimator
    const gpuType = document.getElementById('gpu-type') as HTMLSelectElement
    const gpuCount = document.getElementById('gpu-count') as HTMLInputElement
    const gpuHours = document.getElementById('gpu-hours') as HTMLInputElement
    const gpuCountVal = document.getElementById('gpu-count-val')!
    const gpuHoursVal = document.getElementById('gpu-hours-val')!
    const cloudCost = document.getElementById('cloud-cost')!

    function calcCloud() {
      const rate = parseFloat(gpuType.value)
      const count = parseInt(gpuCount.value)
      const hours = parseInt(gpuHours.value)
      gpuCountVal.textContent = String(count)
      gpuHoursVal.textContent = String(hours)
      const monthly = rate * count * hours * 30
      cloudCost.textContent = '$' + monthly.toLocaleString(undefined, { maximumFractionDigits: 0 })
    }
    gpuType.addEventListener('change', calcCloud)
    gpuCount.addEventListener('input', calcCloud)
    gpuHours.addEventListener('input', calcCloud)
    calcCloud()

    // AI API Cost Comparison
    const tokenUsage = document.getElementById('token-usage') as HTMLInputElement
    const tokenUsageVal = document.getElementById('token-usage-val')!
    const cheapestModel = document.getElementById('cheapest-model')!
    const cheapestCost = document.getElementById('cheapest-cost')!
    const models = [
      { name: 'GPT-5 Turbo', input: 5, output: 15 },
      { name: 'Claude 4.5', input: 15, output: 75 },
      { name: 'Gemini Ultra 2.0', input: 7, output: 21 },
      { name: 'Llama 4', input: 0.8, output: 0.8 },
    ]
    function calcTokens() {
      const usage = parseInt(tokenUsage.value)
      tokenUsageVal.textContent = usage + 'M'
      let cheapest = Infinity, cheapName = ''
      for (const m of models) {
        const cost = (usage * 0.7 * m.input) + (usage * 0.3 * m.output)
        if (cost < cheapest) { cheapest = cost; cheapName = m.name }
      }
      cheapestModel.textContent = cheapName
      cheapestCost.textContent = '$' + Math.round(cheapest).toLocaleString() + '/mo'
    }
    tokenUsage.addEventListener('input', calcTokens)
    calcTokens()
  </script>
</IssueLayout>
