const executiveInsights = {
  verdict: 'The week was defined by the "Capital Expenditure Reality Check." Investors punished Shopify for its long-term vision, while Alphabet leveraged international debt markets to double down on hardware. For a Senior Cloud Architect, the roadmap is clear: the era of cheap, general-purpose cloud is over. We are moving into a period where Sovereign Clusters (like the Telus B.C. project) and specialized AI Data Centers (like SoftBank\'s French proposal) will dictate the cost of scale. Supply chain resilience and debt-servicing awareness are now architectural requirements.',
  roiSpotlight: 'Alphabet\'s $17B bond sale — including its first-ever $8.5B Canadian-denominated bonds — reveals that even the world\'s largest companies need new debt instruments to sustain AI capex. For architects, this means hyperscaler pricing stability is no longer guaranteed. Budget for 10–15% infrastructure cost increases over the next 12 months as debt servicing costs flow through to compute pricing.',
  regulationWatch: 'The Telus sovereign AI cluster in B.C. moves Canadian data residency from policy aspiration to physical infrastructure. Combined with ongoing CPPA enforcement, architects serving Canadian regulated industries should plan for workload placement audits. Sovereign compute is becoming a procurement requirement, not a nice-to-have.',
}

const technicalDeepDives = {
  signalVsNoise: [
