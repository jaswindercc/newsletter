---
import Base from '../../layouts/Base.astro'
import NewsSection from '../../components/NewsSection.astro'

const meta = {
  number: 43,
  date: 'Apr 28 – May 1, 2026',
  title: 'Week 18, 2026',
}

// ⚠️ ALL DATA BELOW MUST BE VERIFIED WITH EXACT SOURCE URLS BEFORE PUBLISHING
// Replace placeholder entries with real, verified news only.
// If a story cannot be sourced to a specific article URL, DELETE IT.

const generalNews: { title: string; summary: string; source: string; sourceUrl: string }[] = [
  // ADD VERIFIED general news stories here with EXACT article URLs
  // Example format:
  // {
  //   title: 'Headline Here',
  //   summary: 'What happened and why it matters. 2-3 sentences.',
  //   source: 'Reuters',
  //   sourceUrl: 'https://www.reuters.com/world/specific-article-slug-2026-04-28/',
  // },
]

const majorTechNews: { title: string; summary: string; impact: 'high' | 'medium' | 'low'; source: string; sourceUrl: string }[] = [
  // ADD VERIFIED tech news stories here with EXACT article URLs
  // Focus on PEOPLE: CEOs, founders, board decisions
  // Example format:
  // {
  //   title: 'CEO Name Does Something Newsworthy',
  //   summary: 'Details with verified facts. Source quote if available.',
  //   impact: 'high',
  //   source: 'Bloomberg',
  //   sourceUrl: 'https://www.bloomberg.com/news/articles/2026-04-29/specific-slug',
  // },
]

const majorAcquisitions: { buyer: string; target: string; amount: string; why: string; source: string; sourceUrl: string }[] = [
  // ADD VERIFIED acquisitions here. Verify deal amount against 2+ sources.
  // Private companies do NOT have stock tickers.
  // Example format:
  // {
  //   buyer: 'Acquiring Company',
  //   target: 'Target Company',
  //   amount: '$X.XB',
  //   why: 'Strategic rationale. Who stays/leaves.',
  //   source: 'WSJ',
  //   sourceUrl: 'https://www.wsj.com/articles/specific-article-2026-04-30',
  // },
]

const catalysts: { date: string; event: string; detail: string; source: string; sourceUrl: string }[] = [
  // ADD VERIFIED upcoming events with EXACT dates
  // Example format:
  // {
  //   date: 'May 6',
  //   event: 'Event Name',
  //   detail: 'What to watch for and why.',
  //   source: 'CNBC',
  //   sourceUrl: 'https://www.cnbc.com/2026/04/28/specific-article-slug.html',
  // },
]

const marketData = {
  // ALL market data MUST be verified against Yahoo Finance / Bloomberg
  indices: [] as { name: string; value: string; change: string; direction: 'up' | 'down'; ytd: string; ytdDir: 'up' | 'down' }[],
  // Example:
  // { name: 'S&P 500', value: '5,xxx.xx', change: '+x.x%', direction: 'up', ytd: '+xx.x%', ytdDir: 'up' },

  stocks: [] as { ticker: string; name: string; price: string; change: string; ytd: string; reason: string; source: string; sourceUrl: string }[],
  // ONLY include publicly traded companies with real tickers.
  // No private companies (Databricks, Stripe, etc.)
  // Example:
  // { ticker: 'NVDA', name: 'NVIDIA', price: '$xxx.xx', change: '+x.x%', ytd: '+xx.x%', reason: 'Verified reason', source: 'CNBC', sourceUrl: 'https://...' },
}

const sections = [
  {
    title: 'AI & Machine Learning',
    icon: '🧠',
    color: 'text-purple',
    items: [] as { title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source: string; sourceUrl: string }[],
  },
  {
    title: 'Developer Tools & Languages',
    icon: '⚡',
    color: 'text-green',
    items: [] as { title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source: string; sourceUrl: string }[],
  },
  {
    title: 'Infrastructure & Cloud',
    icon: '☁️',
    color: 'text-blue',
    items: [] as { title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source: string; sourceUrl: string }[],
  },
  {
    title: 'Security & Privacy',
    icon: '🔒',
    color: 'text-red',
    items: [] as { title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source: string; sourceUrl: string }[],
  },
  {
    title: 'Startups & Business',
    icon: '🚀',
    color: 'text-orange',
    items: [] as { title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source: string; sourceUrl: string }[],
  },
  {
    title: 'Hardware & Silicon',
    icon: '🔬',
    color: 'text-pink',
    items: [] as { title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source: string; sourceUrl: string }[],
  },
  {
    title: 'Legacy Tech Spotlight',
    icon: '🏛️',
    color: 'text-cyan',
    items: [] as { title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source: string; sourceUrl: string }[],
  },
]

const totalStories = generalNews.length + majorTechNews.length + majorAcquisitions.length + sections.reduce((a, s) => a + s.items.length, 0)
const hasContent = totalStories > 0
---

<Base title={`Issue #${meta.number} — ${meta.title} | jas`}>
  <div class="max-w-[1080px] mx-auto px-6">
    <!-- Breadcrumb + Nav -->
    <div class="flex items-center justify-between py-4 border-b border-border">
      <div class="flex items-center gap-2 text-[13px] text-text-tertiary">
        <a href="/" class="hover:text-text transition-colors">Home</a>
        <span>/</span>
        <span class="text-text-secondary">Issue #{meta.number}</span>
      </div>
      <a href="/issue/2026-week17" class="text-[13px] text-text-secondary hover:text-blue transition-colors">
        ← Previous Issue
      </a>
    </div>

    <!-- Header -->
    <div class="pt-8 pb-6">
      <div class="flex items-center gap-3 mb-2">
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[11px] font-mono font-medium text-green bg-green/10 border border-green/20 rounded">
          LIVE
        </span>
        <span class="text-[13px] font-mono text-text-tertiary">{meta.date}</span>
      </div>
      <h1 class="text-[36px] font-bold text-text leading-tight">{meta.title}</h1>
      {hasContent ? (
        <p class="mt-2 text-[16px] text-text-secondary">
          {totalStories} stories · {sections.filter(s => s.items.length > 0).length + (generalNews.length > 0 ? 1 : 0) + (majorTechNews.length > 0 ? 1 : 0) + (majorAcquisitions.length > 0 ? 1 : 0) + (catalysts.length > 0 ? 1 : 0)} sections
        </p>
      ) : (
        <div class="mt-4 p-4 rounded-xl border border-orange/30 bg-orange/5">
          <p class="text-[14px] text-orange font-medium">⚠️ This issue is awaiting verified content. Data must be sourced from real articles with exact URLs before publishing.</p>
        </div>
      )}
    </div>

    <!-- === GENERAL NEWS === -->
    {generalNews.length > 0 && (
    <div class="mt-4 mb-8">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[22px]">🌍</span>
        <h2 class="text-[20px] font-bold text-text">Major General News</h2>
        <span class="ml-auto px-2.5 py-0.5 text-[13px] font-mono font-medium text-text-tertiary bg-bg-card border border-border rounded-md">
          {generalNews.length} stories
        </span>
      </div>
      <div class="space-y-2">
        {generalNews.map((item) => (
          <details class="group rounded-xl border border-border hover:border-blue/30 bg-bg-card/50 hover:bg-bg-card transition-all duration-150">
            <summary class="flex items-start gap-4 px-5 py-4 cursor-pointer select-none list-none">
              <div class="flex-1 min-w-0">
                <h3 class="text-[15px] font-semibold text-text leading-snug group-hover:text-blue transition-colors">{item.title}</h3>
              </div>
              <svg class="w-5 h-5 text-text-tertiary mt-0.5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 pt-0">
              <p class="text-[14px] text-text-secondary leading-[1.7]">{item.summary}</p>
              <div class="mt-3 flex items-center gap-4 text-[13px]">
                <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-blue hover:underline">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  {item.source}
                </a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
    )}

    <!-- === MAJOR TECH NEWS === -->
    {majorTechNews.length > 0 && (
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[22px]">👔</span>
        <h2 class="text-[20px] font-bold text-text">Major Tech News</h2>
        <span class="ml-auto px-2.5 py-0.5 text-[13px] font-mono font-medium text-text-tertiary bg-bg-card border border-border rounded-md">
          {majorTechNews.length} stories
        </span>
      </div>
      <div class="space-y-2">
        {majorTechNews.map((item) => (
          <details class="group rounded-xl border border-border hover:border-blue/30 bg-bg-card/50 hover:bg-bg-card transition-all duration-150">
            <summary class="flex items-start gap-4 px-5 py-4 cursor-pointer select-none list-none">
              <span class={`mt-0.5 inline-flex items-center px-2 py-0.5 text-[11px] font-bold rounded border shrink-0 ${item.impact === 'high' ? 'bg-red/15 border-red/30 text-red' : 'bg-orange/15 border-orange/30 text-orange'}`}>
                {item.impact === 'high' ? 'HIGH' : 'MED'}
              </span>
              <div class="flex-1 min-w-0">
                <h3 class="text-[15px] font-semibold text-text leading-snug group-hover:text-blue transition-colors">{item.title}</h3>
              </div>
              <svg class="w-5 h-5 text-text-tertiary mt-0.5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 pt-0 ml-[52px]">
              <p class="text-[14px] text-text-secondary leading-[1.7]">{item.summary}</p>
              <div class="mt-3 flex items-center gap-4 text-[13px]">
                <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-blue hover:underline">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  {item.source}
                </a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
    )}

    <!-- === MAJOR ACQUISITIONS === -->
    {majorAcquisitions.length > 0 && (
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[22px]">🤝</span>
        <h2 class="text-[20px] font-bold text-text">Major Acquisitions</h2>
      </div>
      <div class="space-y-3">
        {majorAcquisitions.map((deal) => (
          <details class="group rounded-xl border border-border hover:border-blue/30 bg-bg-card/50 hover:bg-bg-card transition-all duration-150">
            <summary class="flex items-start gap-4 px-5 py-4 cursor-pointer select-none list-none">
              <div class="flex-1 min-w-0 flex items-center gap-2">
                <span class="text-[14px] font-bold text-blue">{deal.buyer}</span>
                <span class="text-text-tertiary">→</span>
                <span class="text-[14px] font-bold text-text">{deal.target}</span>
                <span class="ml-auto px-2.5 py-0.5 text-[13px] font-mono font-bold text-green bg-green/10 border border-green/20 rounded-md">{deal.amount}</span>
              </div>
              <svg class="w-5 h-5 text-text-tertiary mt-0.5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 pt-0">
              <p class="text-[14px] text-text-secondary leading-[1.7]">{deal.why}</p>
              <div class="mt-2">
                <a href={deal.sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[13px] text-blue hover:underline">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  {deal.source}
                </a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
    )}

    <!-- === CATALYSTS TO WATCH === -->
    {catalysts.length > 0 && (
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[22px]">🔮</span>
        <h2 class="text-[20px] font-bold text-text">Next Major Catalysts to Watch</h2>
      </div>
      <div class="space-y-2">
        {catalysts.map((c) => (
          <details class="group rounded-xl border border-border hover:border-blue/30 bg-bg-card/50 hover:bg-bg-card transition-all duration-150">
            <summary class="flex items-start gap-4 px-5 py-4 cursor-pointer select-none list-none">
              <div class="shrink-0 w-16 text-center">
                <div class="text-[14px] font-bold text-blue font-mono">{c.date}</div>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-[15px] font-semibold text-text leading-snug group-hover:text-blue transition-colors">{c.event}</h3>
              </div>
              <svg class="w-5 h-5 text-text-tertiary mt-0.5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 pt-0 ml-20">
              <p class="text-[13px] text-text-secondary leading-[1.6]">{c.detail}</p>
              <a href={c.sourceUrl} target="_blank" rel="noopener noreferrer" class="mt-1 inline-flex items-center gap-1 text-[12px] text-blue hover:underline">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                {c.source}
              </a>
            </div>
          </details>
        ))}
      </div>
    </div>
    )}

    <!-- === MARKETS === -->
    {marketData.indices.length > 0 && (
    <div class="mb-8 p-6 rounded-xl bg-bg-card border border-border">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[22px]">📈</span>
        <h2 class="text-[20px] font-bold text-text">Markets & Tech Stocks</h2>
        <span class="text-[13px] text-text-tertiary font-mono ml-auto">Week ending May 1, 2026</span>
      </div>

      <!-- Indices -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        {marketData.indices.map((idx) => (
          <div class="p-3 rounded-lg bg-bg border border-border">
            <div class="text-[12px] font-medium text-text-tertiary">{idx.name}</div>
            <div class="text-[16px] font-bold text-text font-mono mt-0.5">{idx.value}</div>
            <div class="flex items-center gap-3 mt-1">
              <div class={`text-[12px] font-mono font-bold ${idx.direction === 'up' ? 'text-green' : 'text-red'}`}>
                {idx.direction === 'up' ? '▲' : '▼'} {idx.change} <span class="text-text-tertiary font-normal">wk</span>
              </div>
              <div class={`text-[12px] font-mono font-bold ${idx.ytdDir === 'up' ? 'text-green' : 'text-red'}`}>
                {idx.ytdDir === 'up' ? '▲' : '▼'} {idx.ytd} <span class="text-text-tertiary font-normal">ytd</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Stock Movers -->
      <h3 class="text-[15px] font-bold text-text mb-3">Notable Tech Stock Moves</h3>
      <div class="overflow-x-auto">
        <table class="w-full text-[13px]">
          <thead>
            <tr class="border-b border-border text-text-tertiary">
              <th class="text-left py-2 pr-3 font-medium">Ticker</th>
              <th class="text-left py-2 pr-3 font-medium">Company</th>
              <th class="text-right py-2 pr-3 font-medium">Price</th>
              <th class="text-right py-2 pr-3 font-medium">Week</th>
              <th class="text-right py-2 pr-3 font-medium">YTD</th>
              <th class="text-left py-2 pr-3 font-medium">Reason</th>
              <th class="text-left py-2 font-medium">Source</th>
            </tr>
          </thead>
          <tbody>
            {marketData.stocks.map((stock) => (
              <tr class="border-b border-border/50 hover:bg-bg-hover transition-colors">
                <td class="py-2.5 pr-3 font-mono font-bold text-blue">{stock.ticker}</td>
                <td class="py-2.5 pr-3 text-text">{stock.name}</td>
                <td class="py-2.5 pr-3 text-right font-mono text-text">{stock.price}</td>
                <td class={`py-2.5 pr-3 text-right font-mono font-bold ${stock.change.startsWith('+') ? 'text-green' : 'text-red'}`}>{stock.change}</td>
                <td class={`py-2.5 pr-3 text-right font-mono font-bold ${stock.ytd.startsWith('+') ? 'text-green' : stock.ytd.startsWith('-') ? 'text-red' : 'text-blue'}`}>{stock.ytd}</td>
                <td class="py-2.5 pr-3 text-text-secondary max-w-[300px]">{stock.reason}</td>
                <td class="py-2.5 text-text-tertiary italic">{stock.source}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    )}

    <!-- Category nav -->
    {sections.some(s => s.items.length > 0) && (
    <div class="mb-6">
      <h2 class="text-[18px] font-bold text-text mb-3">Deep Dives by Category</h2>
      <div class="flex flex-wrap gap-2">
        {sections.filter(s => s.items.length > 0).map((s) => (
          <a href={`#${s.title.toLowerCase().split(' ')[0]}`} class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[13px] text-text-secondary bg-bg-card border border-border rounded-lg hover:bg-bg-hover hover:border-blue/30 transition-all">
            <span>{s.icon}</span>
            <span>{s.title}</span>
            <span class="text-text-tertiary font-mono ml-1">{s.items.length}</span>
          </a>
        ))}
      </div>
    </div>
    )}

    <!-- All Category Sections -->
    {sections.filter(s => s.items.length > 0).map((section) => (
      <NewsSection
        title={section.title}
        icon={section.icon}
        color={section.color}
        items={section.items}
      />
    ))}

    <!-- Interactive Widgets -->
    <div class="mt-14 mb-10">
      <h2 class="text-[22px] font-bold text-text mb-6 flex items-center gap-2">
        <span>🧰</span> Interactive Tools
      </h2>

      <div class="grid md:grid-cols-2 gap-4">
        <!-- Cloud Cost Estimator -->
        <div class="p-5 rounded-xl bg-bg-card border border-border">
          <h3 class="text-[15px] font-bold text-text mb-1 flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-green"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            Cloud Cost Estimator
          </h3>
          <p class="text-[13px] text-text-tertiary mb-4">Estimate monthly cloud spend for AI workloads.</p>
          <div class="space-y-3">
            <div>
              <label class="text-[12px] font-medium text-text-secondary block mb-1">GPU Type</label>
              <select id="gpu-type" class="w-full px-3 py-2 text-[13px] bg-bg border border-border rounded-lg text-text focus:border-blue/50 focus:outline-none">
                <option value="3.25">NVIDIA H100 ($3.25/hr)</option>
                <option value="6.50">NVIDIA B200 ($6.50/hr)</option>
                <option value="1.10">NVIDIA A100 ($1.10/hr)</option>
                <option value="0.45">NVIDIA T4 ($0.45/hr)</option>
              </select>
            </div>
            <div>
              <label class="text-[12px] font-medium text-text-secondary block mb-1">GPUs Needed</label>
              <input type="range" id="gpu-count" min="1" max="64" value="4" class="w-full accent-green" />
              <div class="flex justify-between text-[12px] text-text-tertiary"><span>1</span><span id="gpu-count-val">4</span><span>64</span></div>
            </div>
            <div>
              <label class="text-[12px] font-medium text-text-secondary block mb-1">Hours/Day</label>
              <input type="range" id="gpu-hours" min="1" max="24" value="8" class="w-full accent-green" />
              <div class="flex justify-between text-[12px] text-text-tertiary"><span>1</span><span id="gpu-hours-val">8</span><span>24</span></div>
            </div>
            <div class="pt-3 border-t border-border">
              <div class="text-[13px] text-text-tertiary">Estimated Monthly Cost</div>
              <div id="cloud-cost" class="text-[28px] font-bold text-green">$3,120</div>
            </div>
          </div>
        </div>

        <!-- AI API Cost Comparison -->
        <div class="p-5 rounded-xl bg-bg-card border border-border">
          <h3 class="text-[15px] font-bold text-text mb-1 flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-purple"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            AI API Cost Comparison
          </h3>
          <p class="text-[13px] text-text-tertiary mb-4">Compare costs per 1M tokens (input / output).</p>
          <div class="space-y-2">
            <div class="flex items-center gap-2 p-2 rounded-lg bg-bg-hover">
              <span class="w-2 h-2 rounded-full bg-purple"></span>
              <span class="text-[13px] text-text flex-1">GPT-5 Turbo</span>
              <span class="text-[13px] font-mono text-text-secondary">$5 / $15</span>
            </div>
            <div class="flex items-center gap-2 p-2 rounded-lg bg-bg-hover">
              <span class="w-2 h-2 rounded-full bg-orange"></span>
              <span class="text-[13px] text-text flex-1">Claude 4.5</span>
              <span class="text-[13px] font-mono text-text-secondary">$15 / $75</span>
            </div>
            <div class="flex items-center gap-2 p-2 rounded-lg bg-bg-hover">
              <span class="w-2 h-2 rounded-full bg-blue"></span>
              <span class="text-[13px] text-text flex-1">Gemini Ultra 2.0</span>
              <span class="text-[13px] font-mono text-text-secondary">$7 / $21</span>
            </div>
            <div class="flex items-center gap-2 p-2 rounded-lg bg-bg-hover">
              <span class="w-2 h-2 rounded-full bg-green"></span>
              <span class="text-[13px] text-text flex-1">Llama 4 (self-hosted)</span>
              <span class="text-[13px] font-mono text-text-secondary">~$0.80 / ~$0.80</span>
            </div>
            <div class="pt-3 border-t border-border mt-3">
              <label class="text-[12px] font-medium text-text-secondary block mb-1">Monthly Tokens (Millions)</label>
              <input type="range" id="token-usage" min="1" max="100" value="10" class="w-full accent-purple" />
              <div class="flex justify-between text-[12px] text-text-tertiary"><span>1M</span><span id="token-usage-val">10M</span><span>100M</span></div>
              <div class="mt-2 text-[13px] text-text-tertiary">Cheapest: <span id="cheapest-model" class="font-bold text-green">Llama 4</span> at <span id="cheapest-cost" class="font-bold text-green">$16/mo</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Cloud Cost Estimator
      const gpuType = document.getElementById('gpu-type') as HTMLSelectElement
      const gpuCount = document.getElementById('gpu-count') as HTMLInputElement
      const gpuHours = document.getElementById('gpu-hours') as HTMLInputElement
      const gpuCountVal = document.getElementById('gpu-count-val')!
      const gpuHoursVal = document.getElementById('gpu-hours-val')!
      const cloudCost = document.getElementById('cloud-cost')!

      function calcCloud() {
        const rate = parseFloat(gpuType.value)
        const count = parseInt(gpuCount.value)
        const hours = parseInt(gpuHours.value)
        gpuCountVal.textContent = String(count)
        gpuHoursVal.textContent = String(hours)
        const monthly = rate * count * hours * 30
        cloudCost.textContent = '$' + monthly.toLocaleString(undefined, { maximumFractionDigits: 0 })
      }
      gpuType.addEventListener('change', calcCloud)
      gpuCount.addEventListener('input', calcCloud)
      gpuHours.addEventListener('input', calcCloud)
      calcCloud()

      // AI API Cost Comparison
      const tokenUsage = document.getElementById('token-usage') as HTMLInputElement
      const tokenUsageVal = document.getElementById('token-usage-val')!
      const cheapestModel = document.getElementById('cheapest-model')!
      const cheapestCost = document.getElementById('cheapest-cost')!
      const models = [
        { name: 'GPT-5 Turbo', input: 5, output: 15 },
        { name: 'Claude 4.5', input: 15, output: 75 },
        { name: 'Gemini Ultra 2.0', input: 7, output: 21 },
        { name: 'Llama 4', input: 0.8, output: 0.8 },
      ]
      function calcTokens() {
        const usage = parseInt(tokenUsage.value)
        tokenUsageVal.textContent = usage + 'M'
        let cheapest = Infinity, cheapName = ''
        for (const m of models) {
          const cost = (usage * 0.7 * m.input) + (usage * 0.3 * m.output)
          if (cost < cheapest) { cheapest = cost; cheapName = m.name }
        }
        cheapestModel.textContent = cheapName
        cheapestCost.textContent = '$' + Math.round(cheapest).toLocaleString() + '/mo'
      }
      tokenUsage.addEventListener('input', calcTokens)
      calcTokens()
    </script>

