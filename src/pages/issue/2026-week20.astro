            <span class="w-2 h-2 rounded-full bg-purple"></span>
            <span class="text-[13px] text-text flex-1">GPT-5 Turbo</span>
            <span class="text-[13px] font-mono text-text-secondary">$5 / $15</span>
          </div>
          <div class="flex items-center gap-2 p-2 rounded-lg bg-bg-hover">
            <span class="w-2 h-2 rounded-full bg-orange"></span>
            <span class="text-[13px] text-text flex-1">Claude 4.5</span>
            <span class="text-[13px] font-mono text-text-secondary">$15 / $75</span>
          </div>
          <div class="flex items-center gap-2 p-2 rounded-lg bg-bg-hover">
            <span class="w-2 h-2 rounded-full bg-blue"></span>
            <span class="text-[13px] text-text flex-1">Gemini Ultra 2.0</span>
            <span class="text-[13px] font-mono text-text-secondary">$7 / $21</span>
          </div>
          <div class="flex items-center gap-2 p-2 rounded-lg bg-bg-hover">
            <span class="w-2 h-2 rounded-full bg-green"></span>
            <span class="text-[13px] text-text flex-1">Llama 4 (self-hosted)</span>
            <span class="text-[13px] font-mono text-text-secondary">~$0.80 / ~$0.80</span>
          </div>
          <div class="pt-3 border-t border-border mt-3">
            <label class="text-[12px] font-medium text-text-secondary block mb-1">Monthly Tokens (Millions)</label>
            <input type="range" id="token-usage" min="1" max="100" value="10" class="w-full accent-purple" />
            <div class="flex justify-between text-[12px] text-text-tertiary"><span>1M</span><span id="token-usage-val">10M</span><span>100M</span></div>
            <div class="mt-2 text-[13px] text-text-tertiary">Cheapest: <span id="cheapest-model" class="font-bold text-green">Llama 4</span> at <span id="cheapest-cost" class="font-bold text-green">$16/mo</span></div>
          </div>
        </div>
        <div class="mt-3 flex justify-end">
          <a href="/tools/ai-api-cost-comparison" class="text-[12px] text-text-tertiary hover:text-blue transition-colors inline-flex items-center gap-1">Open full tool <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Cloud Cost Estimator
    const gpuType = document.getElementById('gpu-type') as HTMLSelectElement
    const gpuCount = document.getElementById('gpu-count') as HTMLInputElement
    const gpuHours = document.getElementById('gpu-hours') as HTMLInputElement
    const gpuCountVal = document.getElementById('gpu-count-val')!
    const gpuHoursVal = document.getElementById('gpu-hours-val')!
    const cloudCost = document.getElementById('cloud-cost')!

    function calcCloud() {
      const rate = parseFloat(gpuType.value)
      const count = parseInt(gpuCount.value)
      const hours = parseInt(gpuHours.value)
      gpuCountVal.textContent = String(count)
      gpuHoursVal.textContent = String(hours)
      const monthly = rate * count * hours * 30
      cloudCost.textContent = '$' + monthly.toLocaleString(undefined, { maximumFractionDigits: 0 })
    }
    gpuType.addEventListener('change', calcCloud)
    gpuCount.addEventListener('input', calcCloud)
    gpuHours.addEventListener('input', calcCloud)
    calcCloud()

    // AI API Cost Comparison
    const tokenUsage = document.getElementById('token-usage') as HTMLInputElement
    const tokenUsageVal = document.getElementById('token-usage-val')!
    const cheapestModel = document.getElementById('cheapest-model')!
    const cheapestCost = document.getElementById('cheapest-cost')!
    const models = [
      { name: 'GPT-5 Turbo', input: 5, output: 15 },
      { name: 'Claude 4.5', input: 15, output: 75 },
      { name: 'Gemini Ultra 2.0', input: 7, output: 21 },
      { name: 'Llama 4', input: 0.8, output: 0.8 },
    ]
    function calcTokens() {
      const usage = parseInt(tokenUsage.value)
      tokenUsageVal.textContent = usage + 'M'
      let cheapest = Infinity, cheapName = ''
      for (const m of models) {
        const cost = (usage * 0.7 * m.input) + (usage * 0.3 * m.output)
        if (cost < cheapest) { cheapest = cost; cheapName = m.name }
      }
      cheapestModel.textContent = cheapName
      cheapestCost.textContent = '$' + Math.round(cheapest).toLocaleString() + '/mo'
    }
    tokenUsage.addEventListener('input', calcTokens)
    calcTokens()
  </script>
