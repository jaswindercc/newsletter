---
import Base from '../../layouts/Base.astro'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Password Strength Analyzer',
  description: 'Test password entropy and estimated crack time against modern hardware. Everything runs locally in your browser.',
  url: 'https://jas.dev/tools/password-strength-analyzer',
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'Web Browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---
<Base title="Password Strength Analyzer — Entropy & Crack Time Estimator | jas Tools" description="Test password entropy and estimated crack time against modern hardware. 100% client-side — nothing leaves your browser. Free security tool." jsonLd={jsonLd}>
  <div class="max-w-[720px] mx-auto px-6 py-12">
    <div class="flex items-center gap-2 text-[13px] text-text-tertiary pb-4 border-b border-border mb-8">
      <a href="/" class="hover:text-text transition-colors">Home</a><span>/</span>
      <a href="/tools" class="hover:text-text transition-colors">Tools</a><span>/</span>
      <span class="text-text-secondary">Password Strength Analyzer</span>
    </div>
    <h1 class="text-[28px] font-bold text-text mb-2">Password Strength Analyzer</h1>
    <p class="text-[15px] text-text-secondary mb-8">Test password entropy and estimated crack time against modern hardware. Everything runs locally — nothing leaves your browser.</p>

    <div class="p-6 rounded-xl bg-bg-card border border-border">
      <div class="space-y-4">
        <div>
          <label class="text-[13px] font-medium text-text-secondary block mb-1.5">Enter a password</label>
          <input type="text" id="pw-input" autocomplete="off" placeholder="Type a password to test..." class="w-full px-3 py-2.5 text-[14px] bg-bg border border-border rounded-lg text-text font-mono focus:border-blue/50 focus:outline-none" />
        </div>
        <div class="pt-4 border-t border-border">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[13px] text-text-tertiary">Strength</span>
            <span id="strength-label" class="text-[14px] font-bold text-text-tertiary">—</span>
          </div>
          <div class="w-full h-2 rounded-full bg-bg-hover overflow-hidden">
            <div id="strength-bar" class="h-full rounded-full bg-border transition-all" style="width: 0%"></div>
          </div>
          <div class="grid grid-cols-2 gap-3 mt-4">
            <div class="p-3 rounded-lg bg-bg border border-border">
              <div class="text-[12px] text-text-tertiary">Entropy</div>
              <div id="entropy" class="text-[18px] font-mono font-bold text-text mt-0.5">0 bits</div>
            </div>
            <div class="p-3 rounded-lg bg-bg border border-border">
              <div class="text-[12px] text-text-tertiary">Estimated crack time</div>
              <div id="crack-time" class="text-[18px] font-mono font-bold text-text mt-0.5">—</div>
            </div>
          </div>
          <div class="mt-3 p-3 rounded-lg bg-bg border border-border">
            <div class="text-[12px] text-text-tertiary">Character pool size</div>
            <div id="pool-info" class="text-[14px] font-mono text-text-secondary mt-0.5">—</div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 text-center">
      <a href="/tools" class="text-[14px] text-text-secondary hover:text-blue transition-colors inline-flex items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        All Tools
      </a>
    </div>
  </div>

  <script>
    const input = document.getElementById('pw-input') as HTMLInputElement
    function analyze() {
      const pw = input.value
      let pool = 0, sets: string[] = []
      if (/[a-z]/.test(pw)) { pool += 26; sets.push('lowercase') }
      if (/[A-Z]/.test(pw)) { pool += 26; sets.push('uppercase') }
      if (/[0-9]/.test(pw)) { pool += 10; sets.push('digits') }
      if (/[^a-zA-Z0-9]/.test(pw)) { pool += 32; sets.push('symbols') }
      const entropy = pw.length > 0 ? Math.round(pw.length * Math.log2(Math.max(pool, 1))) : 0
      document.getElementById('entropy')!.textContent = entropy + ' bits'
      document.getElementById('pool-info')!.textContent = pool > 0 ? pool + ' chars (' + sets.join(' + ') + ')' : '—'
      const bar = document.getElementById('strength-bar')!
      const label = document.getElementById('strength-label')!
      const guessesPer = 1e12 // 1 trillion guesses/sec (modern GPU cluster)
      const combos = Math.pow(2, entropy)
      const seconds = combos / guessesPer / 2
      let crackText = '—'
      if (pw.length > 0) {
        if (seconds < 1) crackText = 'Instant'
        else if (seconds < 60) crackText = Math.round(seconds) + ' seconds'
        else if (seconds < 3600) crackText = Math.round(seconds / 60) + ' minutes'
        else if (seconds < 86400) crackText = Math.round(seconds / 3600) + ' hours'
        else if (seconds < 31536000) crackText = Math.round(seconds / 86400) + ' days'
        else if (seconds < 31536000 * 1000) crackText = Math.round(seconds / 31536000) + ' years'
        else if (seconds < 31536000 * 1e6) crackText = Math.round(seconds / 31536000 / 1000) + 'K years'
        else crackText = '> 1M years'
      }
      document.getElementById('crack-time')!.textContent = crackText
      if (entropy === 0) { bar.style.width = '0%'; bar.className = 'h-full rounded-full bg-border transition-all'; label.textContent = '—'; label.className = 'text-[14px] font-bold text-text-tertiary' }
      else if (entropy < 28) { bar.style.width = '15%'; bar.className = 'h-full rounded-full bg-red transition-all'; label.textContent = 'Very Weak'; label.className = 'text-[14px] font-bold text-red' }
      else if (entropy < 36) { bar.style.width = '30%'; bar.className = 'h-full rounded-full bg-red transition-all'; label.textContent = 'Weak'; label.className = 'text-[14px] font-bold text-red' }
      else if (entropy < 60) { bar.style.width = '50%'; bar.className = 'h-full rounded-full bg-orange transition-all'; label.textContent = 'Fair'; label.className = 'text-[14px] font-bold text-orange' }
      else if (entropy < 80) { bar.style.width = '75%'; bar.className = 'h-full rounded-full bg-blue transition-all'; label.textContent = 'Strong'; label.className = 'text-[14px] font-bold text-blue' }
      else { bar.style.width = '100%'; bar.className = 'h-full rounded-full bg-green transition-all'; label.textContent = 'Very Strong'; label.className = 'text-[14px] font-bold text-green' }
    }
    input.addEventListener('input', analyze)
  </script>
</Base>
