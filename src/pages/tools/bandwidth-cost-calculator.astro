---
import Base from '../../layouts/Base.astro'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Bandwidth Cost Calculator',
  description: 'Calculate monthly egress costs across AWS, Azure, and GCP at different traffic volumes.',
  url: 'https://techbrief.jaswinder.cc/tools/bandwidth-cost-calculator',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web Browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---
<Base title="Bandwidth & Egress Cost Calculator — AWS vs Azure vs GCP | jas Tools" description="Calculate monthly egress costs across AWS, Azure, and GCP at different traffic volumes. Compare cloud bandwidth pricing. Free tool." jsonLd={jsonLd} breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Tools', url: '/tools' }, { name: 'Bandwidth Cost Calculator', url: '/tools/bandwidth-cost-calculator' }]}>
  <div class="max-w-[720px] mx-auto px-6 py-12">
    <div class="flex items-center gap-2 text-[13px] text-text-tertiary pb-4 border-b border-border mb-8">
      <a href="/" class="hover:text-text transition-colors">Home</a><span>/</span>
      <a href="/tools" class="hover:text-text transition-colors">Tools</a><span>/</span>
      <span class="text-text-secondary">Bandwidth Cost Calculator</span>
    </div>
    <h1 class="text-[28px] font-bold text-text mb-2">Bandwidth Cost Calculator</h1>
    <p class="text-[15px] text-text-secondary mb-8">Calculate monthly egress costs across AWS, Azure, and GCP at different traffic volumes.</p>

    <div class="p-6 rounded-xl bg-bg-card border border-border">
      <div class="space-y-4">
        <div>
          <label class="text-[13px] font-medium text-text-secondary block mb-1.5">Monthly Egress (TB)</label>
          <input type="range" id="egress-tb" min="1" max="100" value="10" class="w-full accent-blue" />
          <div class="flex justify-between text-[12px] text-text-tertiary"><span>1 TB</span><span id="egress-val">10 TB</span><span>100 TB</span></div>
        </div>
        <div class="pt-4 border-t border-border space-y-3">
          <div class="flex items-center justify-between p-3 rounded-lg bg-bg-hover">
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-orange shrink-0"></span><span class="text-[14px] text-text">AWS</span></div>
            <div class="flex items-center gap-4"><span class="text-[12px] text-text-tertiary font-mono">$0.09/GB</span><span id="cost-aws" class="text-[16px] font-mono font-bold text-text">$921</span></div>
          </div>
          <div class="flex items-center justify-between p-3 rounded-lg bg-bg-hover">
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-blue shrink-0"></span><span class="text-[14px] text-text">Azure</span></div>
            <div class="flex items-center gap-4"><span class="text-[12px] text-text-tertiary font-mono">$0.087/GB</span><span id="cost-azure" class="text-[16px] font-mono font-bold text-text">$890</span></div>
          </div>
          <div class="flex items-center justify-between p-3 rounded-lg bg-bg-hover">
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-red shrink-0"></span><span class="text-[14px] text-text">GCP</span></div>
            <div class="flex items-center gap-4"><span class="text-[12px] text-text-tertiary font-mono">$0.12/GB</span><span id="cost-gcp" class="text-[16px] font-mono font-bold text-text">$1,228</span></div>
          </div>
          <div class="pt-2">
            <div class="text-[13px] text-text-tertiary">Monthly savings switching to cheapest: <span id="savings" class="font-bold text-green">$338</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 text-center">
      <a href="/tools" class="text-[14px] text-text-secondary hover:text-blue transition-colors inline-flex items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        All Tools
      </a>
    </div>
  </div>

  <script>
    const slider = document.getElementById('egress-tb') as HTMLInputElement
    const val = document.getElementById('egress-val')!
    const rates = { aws: 0.09, azure: 0.087, gcp: 0.12 }
    function calc() {
      const tb = parseInt(slider.value)
      val.textContent = tb + ' TB'
      const gb = tb * 1024
      const costs = { aws: gb * rates.aws, azure: gb * rates.azure, gcp: gb * rates.gcp }
      document.getElementById('cost-aws')!.textContent = '$' + Math.round(costs.aws).toLocaleString()
      document.getElementById('cost-azure')!.textContent = '$' + Math.round(costs.azure).toLocaleString()
      document.getElementById('cost-gcp')!.textContent = '$' + Math.round(costs.gcp).toLocaleString()
      const min = Math.min(costs.aws, costs.azure, costs.gcp)
      const max = Math.max(costs.aws, costs.azure, costs.gcp)
      document.getElementById('savings')!.textContent = '$' + Math.round(max - min).toLocaleString()
    }
    slider.addEventListener('input', calc)
    calc()
  </script>
</Base>
