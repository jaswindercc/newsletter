---
import Base from '../../layouts/Base.astro'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Tech Debt ROI Calculator',
  description: 'Quantify the cost of technical debt and project ROI of paying it down over time.',
  url: 'https://techbrief.jaswinder.cc/tools/tech-debt-roi-calculator',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web Browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---
<Base title="Tech Debt ROI Calculator — Quantify the Cost of Technical Debt | jas Tools" description="Quantify the cost of technical debt and calculate ROI of paying it down. Make data-driven prioritization decisions. Free calculator." jsonLd={jsonLd} breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Tools', url: '/tools' }, { name: 'Tech Debt ROI Calculator', url: '/tools/tech-debt-roi-calculator' }]}>
  <div class="max-w-[720px] mx-auto px-6 py-12">
    <div class="flex items-center gap-2 text-[13px] text-text-tertiary pb-4 border-b border-border mb-8">
      <a href="/" class="hover:text-text transition-colors">Home</a><span>/</span>
      <a href="/tools" class="hover:text-text transition-colors">Tools</a><span>/</span>
      <span class="text-text-secondary">Tech Debt ROI Calculator</span>
    </div>
    <h1 class="text-[28px] font-bold text-text mb-2">Tech Debt ROI Calculator</h1>
    <p class="text-[15px] text-text-secondary mb-8">Quantify the cost of technical debt and project ROI of paying it down over time.</p>

    <div class="p-6 rounded-xl bg-bg-card border border-border">
      <div class="space-y-4">
        <div>
          <label class="text-[13px] font-medium text-text-secondary block mb-1.5">Developer Hours Lost to Debt / Week</label>
          <input type="range" id="hours-lost" min="1" max="40" value="8" class="w-full accent-orange" />
          <div class="flex justify-between text-[12px] text-text-tertiary"><span>1 hr</span><span id="hours-val">8 hrs</span><span>40 hrs</span></div>
        </div>
        <div>
          <label class="text-[13px] font-medium text-text-secondary block mb-1.5">Team Size (developers)</label>
          <input type="range" id="team-size" min="1" max="50" value="5" class="w-full accent-orange" />
          <div class="flex justify-between text-[12px] text-text-tertiary"><span>1</span><span id="team-val">5</span><span>50</span></div>
        </div>
        <div>
          <label class="text-[13px] font-medium text-text-secondary block mb-1.5">Average Developer Cost ($/hr)</label>
          <input type="range" id="dev-rate" min="50" max="250" value="85" step="5" class="w-full accent-orange" />
          <div class="flex justify-between text-[12px] text-text-tertiary"><span>$50</span><span id="rate-val">$85</span><span>$250</span></div>
        </div>
        <div class="pt-4 border-t border-border grid grid-cols-2 gap-3">
          <div class="p-3 rounded-lg bg-bg border border-border">
            <div class="text-[12px] text-text-tertiary">Weekly cost of debt</div>
            <div id="weekly-cost" class="text-[20px] font-mono font-bold text-red mt-0.5">$3,400</div>
          </div>
          <div class="p-3 rounded-lg bg-bg border border-border">
            <div class="text-[12px] text-text-tertiary">Annual cost of debt</div>
            <div id="annual-cost" class="text-[20px] font-mono font-bold text-red mt-0.5">$176,800</div>
          </div>
          <div class="p-3 rounded-lg bg-bg border border-border col-span-2">
            <div class="text-[12px] text-text-tertiary">If a 2-week sprint reduces debt by 50%, ROI payback period</div>
            <div id="payback" class="text-[20px] font-mono font-bold text-green mt-0.5">5.0 weeks</div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 text-center">
      <a href="/tools" class="text-[14px] text-text-secondary hover:text-blue transition-colors inline-flex items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        All Tools
      </a>
    </div>
  </div>

  <script>
    const hours = document.getElementById('hours-lost') as HTMLInputElement
    const team = document.getElementById('team-size') as HTMLInputElement
    const rate = document.getElementById('dev-rate') as HTMLInputElement
    function calc() {
      const h = parseInt(hours.value), t = parseInt(team.value), r = parseInt(rate.value)
      document.getElementById('hours-val')!.textContent = h + ' hrs'
      document.getElementById('team-val')!.textContent = String(t)
      document.getElementById('rate-val')!.textContent = '$' + r
      const weeklyCost = h * t * r
      document.getElementById('weekly-cost')!.textContent = '$' + weeklyCost.toLocaleString()
      document.getElementById('annual-cost')!.textContent = '$' + (weeklyCost * 52).toLocaleString()
      const sprintCost = t * 80 * r // 2-week sprint, 40hr/wk
      const weeklySaving = weeklyCost * 0.5
      document.getElementById('payback')!.textContent = (sprintCost / weeklySaving).toFixed(1) + ' weeks'
    }
    hours.addEventListener('input', calc)
    team.addEventListener('input', calc)
    rate.addEventListener('input', calc)
    calc()
  </script>
</Base>
