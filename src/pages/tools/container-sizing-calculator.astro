---
import Base from '../../layouts/Base.astro'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Container Sizing Calculator',
  description: 'Right-size Kubernetes pod requests and limits based on workload type and expected traffic.',
  url: 'https://techbrief.jaswinder.cc/tools/container-sizing-calculator',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web Browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---
<Base title="Container Sizing Calculator — Kubernetes Pod CPU & Memory Limits | jas Tools" description="Right-size Kubernetes pod requests and limits based on workload type and expected traffic. Free container resource calculator." jsonLd={jsonLd} breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Tools', url: '/tools' }, { name: 'Container Sizing Calculator', url: '/tools/container-sizing-calculator' }]}>
  <div class="max-w-[720px] mx-auto px-6 py-12">
    <div class="flex items-center gap-2 text-[13px] text-text-tertiary pb-4 border-b border-border mb-8">
      <a href="/" class="hover:text-text transition-colors">Home</a><span>/</span>
      <a href="/tools" class="hover:text-text transition-colors">Tools</a><span>/</span>
      <span class="text-text-secondary">Container Sizing Calculator</span>
    </div>
    <h1 class="text-[28px] font-bold text-text mb-2">Container Sizing Calculator</h1>
    <p class="text-[15px] text-text-secondary mb-8">Right-size Kubernetes pod requests and limits based on workload type and expected traffic.</p>

    <div class="p-6 rounded-xl bg-bg-card border border-border">
      <div class="space-y-4">
        <div>
          <label class="text-[13px] font-medium text-text-secondary block mb-1.5">Workload Type</label>
          <select id="workload" class="w-full px-3 py-2.5 text-[14px] bg-bg border border-border rounded-lg text-text focus:border-blue/50 focus:outline-none">
            <option value="api">API Server (low CPU, low memory)</option>
            <option value="worker">Background Worker (medium CPU, medium memory)</option>
            <option value="ml" selected>ML Inference (high CPU, high memory)</option>
            <option value="db">Database (low CPU, very high memory)</option>
          </select>
        </div>
        <div>
          <label class="text-[13px] font-medium text-text-secondary block mb-1.5">Expected RPS (requests/sec)</label>
          <input type="range" id="rps" min="10" max="10000" value="500" step="10" class="w-full accent-cyan" />
          <div class="flex justify-between text-[12px] text-text-tertiary"><span>10</span><span id="rps-val">500</span><span>10,000</span></div>
        </div>
        <div class="pt-4 border-t border-border">
          <h3 class="text-[14px] font-bold text-text mb-3">Recommended Pod Spec</h3>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-3 rounded-lg bg-bg border border-border">
              <div class="text-[12px] text-text-tertiary">CPU Request</div>
              <div id="cpu-req" class="text-[18px] font-mono font-bold text-cyan mt-0.5">500m</div>
            </div>
            <div class="p-3 rounded-lg bg-bg border border-border">
              <div class="text-[12px] text-text-tertiary">CPU Limit</div>
              <div id="cpu-lim" class="text-[18px] font-mono font-bold text-cyan mt-0.5">1000m</div>
            </div>
            <div class="p-3 rounded-lg bg-bg border border-border">
              <div class="text-[12px] text-text-tertiary">Memory Request</div>
              <div id="mem-req" class="text-[18px] font-mono font-bold text-blue mt-0.5">1Gi</div>
            </div>
            <div class="p-3 rounded-lg bg-bg border border-border">
              <div class="text-[12px] text-text-tertiary">Memory Limit</div>
              <div id="mem-lim" class="text-[18px] font-mono font-bold text-blue mt-0.5">2Gi</div>
            </div>
          </div>
          <div class="mt-3 p-3 rounded-lg bg-bg border border-border">
            <div class="text-[12px] text-text-tertiary">Replicas needed</div>
            <div id="replicas" class="text-[18px] font-mono font-bold text-green mt-0.5">3</div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 text-center">
      <a href="/tools" class="text-[14px] text-text-secondary hover:text-blue transition-colors inline-flex items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        All Tools
      </a>
    </div>
  </div>

  <script>
    const workload = document.getElementById('workload') as HTMLSelectElement
    const rps = document.getElementById('rps') as HTMLInputElement
    const profiles: Record<string, { cpuBase: number; memBase: number; rpsPerPod: number }> = {
      api: { cpuBase: 250, memBase: 256, rpsPerPod: 1000 },
      worker: { cpuBase: 500, memBase: 512, rpsPerPod: 200 },
      ml: { cpuBase: 1000, memBase: 2048, rpsPerPod: 50 },
      db: { cpuBase: 500, memBase: 4096, rpsPerPod: 500 },
    }
    function fmt(mb: number) { return mb >= 1024 ? (mb / 1024) + 'Gi' : mb + 'Mi' }
    function calc() {
      const p = profiles[workload.value]
      const r = parseInt(rps.value)
      document.getElementById('rps-val')!.textContent = r.toLocaleString()
      const scale = Math.max(1, r / p.rpsPerPod)
      const cpuReq = Math.round(p.cpuBase * Math.min(scale, 2))
      const memReq = Math.round(p.memBase * Math.min(scale, 2))
      document.getElementById('cpu-req')!.textContent = cpuReq + 'm'
      document.getElementById('cpu-lim')!.textContent = (cpuReq * 2) + 'm'
      document.getElementById('mem-req')!.textContent = fmt(memReq)
      document.getElementById('mem-lim')!.textContent = fmt(memReq * 2)
      document.getElementById('replicas')!.textContent = String(Math.max(2, Math.ceil(r / p.rpsPerPod)))
    }
    workload.addEventListener('change', calc)
    rps.addEventListener('input', calc)
    calc()
  </script>
</Base>
