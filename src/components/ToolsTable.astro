---
/**
 * ToolsTable — searchable, paginated table of engineering tools for issue pages.
 * Renders as a static table; search + pagination runs client-side (no framework JS).
 */

interface Tool {
  slug: string
  name: string
  description: string
  category: string
}

interface Props {
  /** Override the default tools list if needed */
  tools?: Tool[]
}

const defaultTools: Tool[] = [
  { slug: 'sla-downtime-calculator', name: 'SLA Downtime Calculator', description: 'Calculate exactly how much downtime your SLA allows per day, week, month, and year.', category: 'Infrastructure' },
  { slug: 'meeting-cost-calculator', name: 'Meeting Cost Calculator', description: 'Find out the true dollar cost of meetings based on attendees, duration, and hourly rates.', category: 'Productivity' },
  { slug: 'cloud-cost-estimator', name: 'Cloud Cost Estimator', description: 'Estimate monthly cloud spend for GPU and AI workloads across major providers.', category: 'Cloud' },
  { slug: 'ai-api-cost-comparison', name: 'AI API Cost Comparison', description: 'Compare per-token pricing for GPT-5, Claude 4.5, Gemini Ultra, and Llama 4 across usage volumes.', category: 'AI' },
  { slug: 'bandwidth-cost-calculator', name: 'Bandwidth Cost Calculator', description: 'Calculate monthly egress costs across AWS, Azure, and GCP at different traffic volumes.', category: 'Cloud' },
  { slug: 'incident-response-timer', name: 'Incident Response Timer', description: 'Track how long until your SLA breach during an active incident, with severity-based thresholds.', category: 'Security' },
  { slug: 'container-sizing-calculator', name: 'Container Sizing Calculator', description: 'Right-size Kubernetes pod requests and limits based on workload profiles and traffic patterns.', category: 'Infrastructure' },
  { slug: 'tech-debt-roi-calculator', name: 'Tech Debt ROI Calculator', description: 'Quantify the cost of technical debt and project ROI of paying it down over time.', category: 'Engineering' },
  { slug: 'password-strength-analyzer', name: 'Password Strength Analyzer', description: 'Test password entropy and estimated crack time against modern hardware benchmarks.', category: 'Security' },
  { slug: 'cron-expression-builder', name: 'Cron Expression Builder', description: 'Build and validate cron expressions with a visual schedule preview and plain-English translation.', category: 'Dev Tools' },
]

const tools = Astro.props.tools ?? defaultTools
const categories = [...new Set(tools.map(t => t.category))]
---

<div class="mt-14 mb-10" id="tools-table-section">
  <h2 class="text-[22px] font-bold text-text mb-6 flex items-center gap-3">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan shrink-0"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 3h-8l-2 4h12z"/></svg>
    Engineering Tools
  </h2>

  <!-- Search & Filter Bar -->
  <div class="flex flex-col sm:flex-row gap-3 mb-4">
    <input
      type="text"
      id="tools-search"
      placeholder="Search tools..."
      class="flex-1 px-4 py-2 text-[14px] bg-bg border border-border rounded-lg text-text placeholder-text-tertiary focus:outline-none focus:border-blue/50 focus:ring-1 focus:ring-blue/30 transition-all"
    />
    <select id="tools-category-filter" class="px-3 py-2 text-[14px] bg-bg border border-border rounded-lg text-text focus:border-blue/50 focus:outline-none">
      <option value="">All Categories</option>
      {categories.map(c => <option value={c}>{c}</option>)}
    </select>
  </div>

  <!-- Table -->
  <div class="overflow-x-auto border border-border rounded-xl">
    <table class="w-full text-left" id="tools-table">
      <thead>
        <tr class="border-b border-border bg-bg-card">
          <th class="px-4 py-3 text-[12px] font-semibold text-text-tertiary uppercase tracking-wider">Tool</th>
          <th class="px-4 py-3 text-[12px] font-semibold text-text-tertiary uppercase tracking-wider hidden sm:table-cell">Category</th>
          <th class="px-4 py-3 text-[12px] font-semibold text-text-tertiary uppercase tracking-wider hidden md:table-cell">Description</th>
          <th class="px-4 py-3 text-[12px] font-semibold text-text-tertiary uppercase tracking-wider text-right">Link</th>
        </tr>
      </thead>
      <tbody>
        {tools.map((tool) => (
          <tr class="tools-row border-b border-border last:border-0 hover:bg-bg-hover transition-colors" data-name={tool.name.toLowerCase()} data-category={tool.category} data-desc={tool.description.toLowerCase()}>
            <td class="px-4 py-3">
              <span class="text-[14px] font-semibold text-text">{tool.name}</span>
              <span class="sm:hidden block text-[12px] text-text-tertiary mt-0.5">{tool.category}</span>
            </td>
            <td class="px-4 py-3 hidden sm:table-cell">
              <span class="inline-block px-2 py-0.5 text-[12px] font-medium text-text-secondary bg-bg-accent border border-border rounded-md">{tool.category}</span>
            </td>
            <td class="px-4 py-3 text-[13px] text-text-secondary hidden md:table-cell">{tool.description}</td>
            <td class="px-4 py-3 text-right">
              <a href={`/tools/${tool.slug}`} class="inline-flex items-center gap-1 text-[13px] font-medium text-blue hover:underline">
                Open <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <div class="flex items-center justify-between mt-4 text-[13px] text-text-tertiary" id="tools-pagination">
    <span id="tools-showing">Showing 1–5 of {tools.length}</span>
    <div class="flex gap-2">
      <button id="tools-prev" class="px-3 py-1.5 border border-border rounded-lg hover:bg-bg-hover transition-colors disabled:opacity-40 disabled:cursor-not-allowed" disabled>Prev</button>
      <button id="tools-next" class="px-3 py-1.5 border border-border rounded-lg hover:bg-bg-hover transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Next</button>
    </div>
  </div>
</div>

<script>
  const PAGE_SIZE = 5
  let currentPage = 0

  const searchInput = document.getElementById('tools-search') as HTMLInputElement
  const categoryFilter = document.getElementById('tools-category-filter') as HTMLSelectElement
  const rows = Array.from(document.querySelectorAll('.tools-row')) as HTMLTableRowElement[]
  const showingEl = document.getElementById('tools-showing')!
  const prevBtn = document.getElementById('tools-prev') as HTMLButtonElement
  const nextBtn = document.getElementById('tools-next') as HTMLButtonElement

  function getFilteredRows(): HTMLTableRowElement[] {
    const q = searchInput.value.toLowerCase().trim()
    const cat = categoryFilter.value
    return rows.filter(row => {
      const matchesSearch = !q || row.dataset.name!.includes(q) || row.dataset.desc!.includes(q)
      const matchesCat = !cat || row.dataset.category === cat
      return matchesSearch && matchesCat
    })
  }

  function render() {
    const filtered = getFilteredRows()
    const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE))
    if (currentPage >= totalPages) currentPage = totalPages - 1

    const start = currentPage * PAGE_SIZE
    const end = start + PAGE_SIZE

    rows.forEach(r => r.style.display = 'none')
    filtered.forEach((r, i) => {
      r.style.display = (i >= start && i < end) ? '' : 'none'
    })

    const showStart = filtered.length === 0 ? 0 : start + 1
    const showEnd = Math.min(end, filtered.length)
    showingEl.textContent = `Showing ${showStart}–${showEnd} of ${filtered.length}`

    prevBtn.disabled = currentPage === 0
    nextBtn.disabled = currentPage >= totalPages - 1
  }

  searchInput.addEventListener('input', () => { currentPage = 0; render() })
  categoryFilter.addEventListener('change', () => { currentPage = 0; render() })
  prevBtn.addEventListener('click', () => { currentPage--; render() })
  nextBtn.addEventListener('click', () => { currentPage++; render() })

  render()
</script>
