---
interface Props {
  title: string
  icon: string
  color: string
  items: Array<{
    date?: string
    title: string
    summary: string
    impact: 'high' | 'medium' | 'low'
    time: string
    source?: string
    sourceUrl?: string
  }>
}

const { title, icon, color, items } = Astro.props

const impactConfig = {
  high: { bg: 'bg-red/15 border-red/30 text-red', label: 'HIGH' },
  medium: { bg: 'bg-orange/15 border-orange/30 text-orange', label: 'MED' },
  low: { bg: 'bg-bg-accent/50 border-border text-text-tertiary', label: 'LOW' },
}

const sectionIcons: Record<string, string> = {
  'Top 5 Security Vulnerabilities': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
  'Security News': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v4M12 16h.01"/></svg>',
  'Products & Cloud Pricing': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>',
  'AI Model Benchmarks': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>',
  'Category Deep Dives': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
  'Regulatory Compliance Drift': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 6v6l4 2"/></svg>',
  'Developer Velocity & Tooling': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
  'Open Source Governance & Forks': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>',
  'Tech Rumours': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>',
  'Sovereign Cloud & Data Residency': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
  'Deprecations & End-of-Life': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg>',
  'Legacy Modernization Tracker': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>',
}

const sectionIcon = sectionIcons[title] || '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>'
---

<section class="py-10 border-b border-border last:border-b-0" id={title.toLowerCase().split(' ')[0]}>
  <div class="flex items-center gap-3 mb-6">
    <span class={`${color} shrink-0`} set:html={sectionIcon} />
    <h2 class="text-[22px] font-bold text-text">{title}</h2>
    <span class="ml-auto px-2.5 py-0.5 text-[13px] font-mono font-medium text-text-tertiary bg-bg-card border border-border rounded-md">
      {items.length} stories
    </span>
  </div>

  <div class="space-y-2">
    {items.map((item, i) => (
      <details class="group rounded-xl border border-border hover:border-blue/30 bg-bg-card/50 hover:bg-bg-card transition-all duration-150">
        <summary class="flex items-start gap-4 px-5 py-4 cursor-pointer select-none list-none">
          <span class={`mt-0.5 inline-flex items-center px-2 py-0.5 text-[11px] font-bold rounded border shrink-0 ${impactConfig[item.impact].bg}`}>
            {impactConfig[item.impact].label}
          </span>
          <div class="flex-1 min-w-0">
            <h3 class="text-[16px] font-semibold text-text leading-snug group-hover:text-blue transition-colors">
              {item.title}
            </h3>
            {item.date && (
              <span class="text-[13px] font-mono text-text-tertiary mt-0.5 block">{item.date}</span>
            )}
          </div>
          <span class="text-[13px] text-text-tertiary font-mono whitespace-nowrap mt-0.5">{item.time}</span>
          <svg class="w-5 h-5 text-text-tertiary mt-0.5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="px-5 pb-5 pt-0 ml-[52px]">
          <p class="text-[15px] text-text-secondary leading-[1.7]">
            {item.summary}
          </p>
          <div class="mt-3 flex items-center gap-4 text-[14px] flex-wrap">
            <span class="font-mono text-text-tertiary flex items-center gap-1">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              {item.time} read
            </span>
            <span class={`font-mono ${impactConfig[item.impact].bg.split(' ')[2]}`}>
              {item.impact} impact
            </span>
            {item.source && (
              <a href={item.sourceUrl || '#'} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-blue hover:underline">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                {item.source}
              </a>
            )}
          </div>
        </div>
      </details>
    ))}
  </div>
</section>
