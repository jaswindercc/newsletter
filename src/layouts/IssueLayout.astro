---
import Base from './Base.astro'
import NewsSection from '../components/NewsSection.astro'

interface Props {
  meta: {
    number: string
    date: string
    title: string
    status: 'live' | 'draft' | 'archived'
    prevIssue?: string
    nextIssue?: string
    marketDateLabel?: string
  }
  generalNews: Array<{ date: string; title: string; summary: string; source: string; sourceUrl: string }>
  majorTechNews: Array<{ date: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; source: string; sourceUrl: string }>
  majorAcquisitions: Array<{ buyer: string; target: string; amount: string; why: string; source: string; sourceUrl: string }>
  catalysts: Array<{ date: string; event: string; detail: string; source: string; sourceUrl: string }>
  marketData: {
    indices: Array<{ name: string; value: string; change: string; direction: 'up' | 'down'; ytd: string; ytdDir: 'up' | 'down' }>
    stocks: Array<{ ticker: string; name: string; price: string; change: string; ytd: string; reason: string; source: string; sourceUrl: string }>
  }
  sections: Array<{
    title: string
    icon: string
    color: string
    items: Array<{ date?: string; title: string; summary: string; impact: 'high' | 'medium' | 'low'; time: string; source?: string; sourceUrl?: string }>
  }>
  executiveInsights?: {
    verdict: string
    roiSpotlight: string
    regulationWatch: string
  }
  technicalDeepDives?: {
    signalVsNoise: Array<{ hype: string; reality: string }>
    infraHealthCheck: string
    legacySpotlight: string
  }
  builderUtility?: {
    toolOfTheWeek: { name: string; description: string; source: string; sourceUrl: string }
    codeSnippet: { title: string; language: string; code: string }
    securityAlert: string
  }
  strategicView?: {
    catalystsTimeline: Array<{ date: string; event: string; detail: string }>
    maImpact: string
    talentShifts: string
  }
}

const {
  meta, generalNews, majorTechNews, majorAcquisitions, catalysts,
  marketData, sections, executiveInsights, technicalDeepDives,
  builderUtility, strategicView,
} = Astro.props

const totalStories = generalNews.length + majorTechNews.length + majorAcquisitions.length + sections.reduce((a, s) => a + s.items.length, 0)
const hasContent = totalStories > 0
const sectionCount = sections.filter(s => s.items.length > 0).length + (generalNews.length > 0 ? 1 : 0) + (majorTechNews.length > 0 ? 1 : 0) + (majorAcquisitions.length > 0 ? 1 : 0) + (catalysts.length > 0 ? 1 : 0)

const statusConfig = {
  live: { label: 'LIVE', class: 'text-green bg-green/10 border-green/20' },
  draft: { label: 'DRAFT', class: 'text-orange bg-orange/10 border-orange/20' },
  archived: { label: 'ARCHIVED', class: 'text-text-tertiary bg-bg-card border-border' },
}

/* SVG icon fragments — inline, no emojis */
const chevron = `<svg class="w-5 h-5 text-text-tertiary mt-0.5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>`
const linkIcon = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>`
---

<Base title={`Issue ${meta.number} — ${meta.title} | jas`}>
  <div class="max-w-[1080px] mx-auto px-6">
    <!-- Breadcrumb + Nav -->
    <div class="flex items-center justify-between py-4 border-b border-border">
      <div class="flex items-center gap-2 text-[13px] text-text-tertiary">
        <a href="/" class="hover:text-text transition-colors">Home</a>
        <span>/</span>
        <span class="text-text-secondary">Issue {meta.number}</span>
      </div>
      <div class="flex items-center gap-4 text-[13px]">
        {meta.prevIssue && (
          <a href={`/issue/${meta.prevIssue}`} class="text-text-secondary hover:text-blue transition-colors">
            <span class="inline-flex items-center gap-1">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              Previous
            </span>
          </a>
        )}
        {meta.nextIssue && (
          <a href={`/issue/${meta.nextIssue}`} class="text-text-secondary hover:text-blue transition-colors">
            <span class="inline-flex items-center gap-1">
              Next
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </a>
        )}
      </div>
    </div>

    <!-- Header -->
    <div class="pt-8 pb-6">
      <div class="flex items-center gap-3 mb-2">
        <span class={`inline-flex items-center gap-1.5 px-2 py-0.5 text-[11px] font-mono font-medium border rounded ${statusConfig[meta.status].class}`}>
          {meta.status === 'live' && <span class="w-1.5 h-1.5 rounded-full bg-green animate-pulse"></span>}
          {statusConfig[meta.status].label}
        </span>
        <span class="text-[13px] font-mono text-text-tertiary">{meta.date}</span>
      </div>
      <h1 class="text-[36px] font-bold text-text leading-tight">{meta.title}</h1>
      {hasContent ? (
        <p class="mt-2 text-[16px] text-text-secondary">
          {totalStories} stories / {sectionCount} sections
        </p>
      ) : (
        <div class="mt-4 p-4 rounded-xl border border-orange/30 bg-orange/5">
          <p class="text-[14px] text-orange font-medium">This issue is awaiting verified content. Data must be sourced from real articles with exact URLs before publishing.</p>
        </div>
      )}
    </div>

    <!-- S1: GENERAL NEWS -->
    {generalNews.length > 0 && (
    <div class="mt-4 mb-8">
      <div class="flex items-center gap-3 mb-5">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-blue shrink-0"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        <h2 class="text-[20px] font-bold text-text">Major General News</h2>
        <span class="ml-auto px-2.5 py-0.5 text-[13px] font-mono font-medium text-text-tertiary bg-bg-card border border-border rounded-md">{generalNews.length}</span>
      </div>
      <div class="space-y-2">
        {generalNews.map((item) => (
          <details class="group rounded-xl border border-border hover:border-blue/30 bg-bg-card/50 hover:bg-bg-card transition-all duration-150">
            <summary class="flex items-start gap-4 px-5 py-4 cursor-pointer select-none list-none">
              <div class="flex-1 min-w-0">
                <h3 class="text-[15px] font-semibold text-text leading-snug group-hover:text-blue transition-colors">{item.title}</h3>
                <span class="text-[12px] font-mono text-text-tertiary mt-0.5 block">{item.date}</span>
              </div>
              <svg class="w-5 h-5 text-text-tertiary mt-0.5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 pt-0">
              <p class="text-[14px] text-text-secondary leading-[1.7]">{item.summary}</p>
              <div class="mt-3 flex items-center gap-4 text-[13px]">
                <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-blue hover:underline">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  {item.source}
                </a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
    )}

    <!-- S2: MAJOR TECH NEWS -->
    {majorTechNews.length > 0 && (
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-5">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-purple shrink-0"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        <h2 class="text-[20px] font-bold text-text">Major Tech News</h2>
        <span class="ml-auto px-2.5 py-0.5 text-[13px] font-mono font-medium text-text-tertiary bg-bg-card border border-border rounded-md">{majorTechNews.length}</span>
      </div>
      <div class="space-y-2">
        {majorTechNews.map((item) => (
          <details class="group rounded-xl border border-border hover:border-blue/30 bg-bg-card/50 hover:bg-bg-card transition-all duration-150">
            <summary class="flex items-start gap-4 px-5 py-4 cursor-pointer select-none list-none">
              <span class={`mt-0.5 inline-flex items-center px-2 py-0.5 text-[11px] font-bold rounded border shrink-0 ${item.impact === 'high' ? 'bg-red/15 border-red/30 text-red' : item.impact === 'medium' ? 'bg-orange/15 border-orange/30 text-orange' : 'bg-bg-accent/50 border-border text-text-tertiary'}`}>
                {item.impact === 'high' ? 'HIGH' : item.impact === 'medium' ? 'MED' : 'LOW'}
              </span>
              <div class="flex-1 min-w-0">
                <h3 class="text-[15px] font-semibold text-text leading-snug group-hover:text-blue transition-colors">{item.title}</h3>
                <span class="text-[12px] font-mono text-text-tertiary mt-0.5 block">{item.date}</span>
              </div>
              <svg class="w-5 h-5 text-text-tertiary mt-0.5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 pt-0 ml-[52px]">
              <p class="text-[14px] text-text-secondary leading-[1.7]">{item.summary}</p>
              <div class="mt-3 flex items-center gap-4 text-[13px]">
                <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-blue hover:underline">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  {item.source}
                </a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
    )}

    <!-- S3: MAJOR ACQUISITIONS -->
    {majorAcquisitions.length > 0 && (
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-5">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-green shrink-0"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <h2 class="text-[20px] font-bold text-text">Major Acquisitions</h2>
      </div>
      <div class="space-y-2">
        {majorAcquisitions.map((deal) => (
          <details class="group rounded-xl border border-border hover:border-blue/30 bg-bg-card/50 hover:bg-bg-card transition-all duration-150">
            <summary class="flex items-start gap-4 px-5 py-4 cursor-pointer select-none list-none">
              <div class="flex-1 min-w-0 flex items-center gap-2">
                <span class="text-[14px] font-bold text-blue">{deal.buyer}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-tertiary"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                <span class="text-[14px] font-bold text-text">{deal.target}</span>
                <span class="ml-auto px-2.5 py-0.5 text-[13px] font-mono font-bold text-green bg-green/10 border border-green/20 rounded-md">{deal.amount}</span>
              </div>
              <svg class="w-5 h-5 text-text-tertiary mt-0.5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 pt-0">
              <p class="text-[14px] text-text-secondary leading-[1.7]">{deal.why}</p>
              <div class="mt-2">
                <a href={deal.sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[13px] text-blue hover:underline">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  {deal.source}
                </a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
    )}

    <!-- S4: CATALYSTS TO WATCH -->
    {catalysts.length > 0 && (
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-5">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-orange shrink-0"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <h2 class="text-[20px] font-bold text-text">Catalysts to Watch</h2>
      </div>
      <div class="space-y-2">
        {catalysts.map((c) => (
          <details class="group rounded-xl border border-border hover:border-blue/30 bg-bg-card/50 hover:bg-bg-card transition-all duration-150">
            <summary class="flex items-start gap-4 px-5 py-4 cursor-pointer select-none list-none">
              <div class="shrink-0 w-16 text-center">
                <div class="text-[14px] font-bold text-blue font-mono">{c.date}</div>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-[15px] font-semibold text-text leading-snug group-hover:text-blue transition-colors">{c.event}</h3>
              </div>
              <svg class="w-5 h-5 text-text-tertiary mt-0.5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 pt-0 ml-20">
              <p class="text-[13px] text-text-secondary leading-[1.6]">{c.detail}</p>
              <a href={c.sourceUrl} target="_blank" rel="noopener noreferrer" class="mt-1 inline-flex items-center gap-1 text-[12px] text-blue hover:underline">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                {c.source}
              </a>
            </div>
          </details>
        ))}
      </div>
    </div>
    )}

    <!-- S5: MARKETS & TECH STOCKS -->
    {marketData.indices.length > 0 && (
    <div class="mb-8 p-6 rounded-xl bg-bg-card border border-border">
      <div class="flex items-center gap-3 mb-5">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-green shrink-0"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
        <h2 class="text-[20px] font-bold text-text">Markets & Tech Stocks</h2>
        {meta.marketDateLabel && <span class="text-[13px] text-text-tertiary font-mono ml-auto">{meta.marketDateLabel}</span>}
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        {marketData.indices.map((idx) => (
          <div class="p-3 rounded-lg bg-bg border border-border">
            <div class="text-[12px] font-medium text-text-tertiary">{idx.name}</div>
            <div class="text-[16px] font-bold text-text font-mono mt-0.5">{idx.value}</div>
            <div class="flex items-center gap-3 mt-1">
              <div class={`text-[12px] font-mono font-bold ${idx.direction === 'up' ? 'text-green' : 'text-red'}`}>
                {idx.direction === 'up' ? '▲' : '▼'} {idx.change} <span class="text-text-tertiary font-normal">wk</span>
              </div>
              <div class={`text-[12px] font-mono font-bold ${idx.ytdDir === 'up' ? 'text-green' : 'text-red'}`}>
                {idx.ytdDir === 'up' ? '▲' : '▼'} {idx.ytd} <span class="text-text-tertiary font-normal">ytd</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      {marketData.stocks.length > 0 && (
        <>
          <h3 class="text-[15px] font-bold text-text mb-3">Notable Tech Stock Moves</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-[13px]">
              <thead>
                <tr class="border-b border-border text-text-tertiary">
                  <th class="text-left py-2 pr-3 font-medium">Ticker</th>
                  <th class="text-left py-2 pr-3 font-medium">Company</th>
                  <th class="text-right py-2 pr-3 font-medium">Price</th>
                  <th class="text-right py-2 pr-3 font-medium">Week</th>
                  <th class="text-right py-2 pr-3 font-medium">YTD</th>
                  <th class="text-left py-2 pr-3 font-medium">Reason</th>
                  <th class="text-left py-2 font-medium">Source</th>
                </tr>
              </thead>
              <tbody>
                {marketData.stocks.map((stock) => (
                  <tr class="border-b border-border/50 hover:bg-bg-hover transition-colors">
                    <td class="py-2.5 pr-3 font-mono font-bold text-blue">{stock.ticker}</td>
                    <td class="py-2.5 pr-3 text-text">{stock.name}</td>
                    <td class="py-2.5 pr-3 text-right font-mono text-text">{stock.price}</td>
                    <td class={`py-2.5 pr-3 text-right font-mono font-bold ${stock.change.startsWith('+') ? 'text-green' : 'text-red'}`}>{stock.change}</td>
                    <td class={`py-2.5 pr-3 text-right font-mono font-bold ${stock.ytd.startsWith('+') ? 'text-green' : stock.ytd.startsWith('-') ? 'text-red' : 'text-blue'}`}>{stock.ytd}</td>
                    <td class="py-2.5 pr-3 text-text-secondary max-w-[300px]">{stock.reason}</td>
                    <td class="py-2.5 text-text-tertiary italic">{stock.source}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
    </div>
    )}

    <!-- S6–S17: Collapsible sections via NewsSection -->
    {sections.some(s => s.items.length > 0) && (
    <div class="mb-6">
      <h2 class="text-[18px] font-bold text-text mb-3">Sections 6–17</h2>
      <div class="flex flex-wrap gap-2">
        {sections.filter(s => s.items.length > 0).map((s) => (
          <a href={`#${s.title.toLowerCase().split(' ')[0]}`} class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[13px] text-text-secondary bg-bg-card border border-border rounded-lg hover:bg-bg-hover hover:border-blue/30 transition-all">
            <span class="text-[10px]">{s.icon}</span>
            <span>{s.title}</span>
            <span class="text-text-tertiary font-mono ml-1">{s.items.length}</span>
          </a>
        ))}
      </div>
    </div>
    )}
    {sections.filter(s => s.items.length > 0).map((section) => (
      <NewsSection title={section.title} icon={section.icon} color={section.color} items={section.items} />
    ))}

    <!-- EDITORIAL: Executive Insights -->
    {executiveInsights && (
    <div class="mt-14 mb-10">
      <h2 class="text-[22px] font-bold text-text mb-6 flex items-center gap-3">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-blue shrink-0"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        The Executive Insights
      </h2>
      <div class="space-y-4">
        <details class="group rounded-xl border border-border bg-bg-card/50 hover:bg-bg-card transition-all">
          <summary class="flex items-start gap-4 px-5 py-4 cursor-pointer select-none list-none">
            <div class="flex-1"><h3 class="text-[15px] font-semibold text-text group-hover:text-blue transition-colors">The Verdict</h3></div>
            <svg class="w-5 h-5 text-text-tertiary mt-0.5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-5 pb-5 pt-0"><p class="text-[14px] text-text-secondary leading-[1.7]">{executiveInsights.verdict}</p></div>
        </details>
        <details class="group rounded-xl border border-border bg-bg-card/50 hover:bg-bg-card transition-all">
          <summary class="flex items-start gap-4 px-5 py-4 cursor-pointer select-none list-none">
            <div class="flex-1"><h3 class="text-[15px] font-semibold text-text group-hover:text-blue transition-colors">ROI Spotlight</h3></div>
            <svg class="w-5 h-5 text-text-tertiary mt-0.5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-5 pb-5 pt-0"><p class="text-[14px] text-text-secondary leading-[1.7]">{executiveInsights.roiSpotlight}</p></div>
        </details>
        <details class="group rounded-xl border border-border bg-bg-card/50 hover:bg-bg-card transition-all">
          <summary class="flex items-start gap-4 px-5 py-4 cursor-pointer select-none list-none">
            <div class="flex-1"><h3 class="text-[15px] font-semibold text-text group-hover:text-blue transition-colors">Regulation & Policy Watch</h3></div>
            <svg class="w-5 h-5 text-text-tertiary mt-0.5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-5 pb-5 pt-0"><p class="text-[14px] text-text-secondary leading-[1.7]">{executiveInsights.regulationWatch}</p></div>
        </details>
      </div>
    </div>
    )}

    <!-- EDITORIAL: Technical Deep-Dives -->
    {technicalDeepDives && (
    <div class="mb-10">
      <h2 class="text-[22px] font-bold text-text mb-6 flex items-center gap-3">
